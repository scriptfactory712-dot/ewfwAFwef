    function updateESP()
        frameCounter = frameCounter + 1
        if renderInterval > 0 and frameCounter % (renderInterval + 1) ~= 0 then return end

        Camera = workspace.CurrentCamera
        if not Camera then return end

        if (vehEnabled and vehRainbow) or (shipEnabled and shipRainbow) or (espEnabled and showChams and chamsRainbow) or (wantedEspEnabled and wRainbow) then
            local hue = (tick() % 4) / 4
            rainbowColor = Color3.fromHSV(hue, 1, 1)
        end

        if autoRefresh and os.clock() >= nextAutoRefresh then
            doAutoRefresh()
        end

        if vehEnabled then updateVehicleESP() end
        if shipEnabled then updateShipESP() end

        local camPos = Camera.CFrame.Position
        local vpX, vpY = Camera.ViewportSize.X, Camera.ViewportSize.Y

        if espEnabled then
            updatePlayerESP(camPos, vpX / 2, vpY / 2)
        end

        if wantedEspEnabled then
            updateWantedESP(camPos, vpX / 2, vpY / 2)
        end

        if NpcSys.Enabled then
            npcUpdateEsp(camPos)
        end

        if ShipSys.Tracer then
            shipTracerUpdate(camPos, vpX / 2, vpY / 2)
        else
            shipTracerHide()
        end
    end

    function startESP()
        if espConn then return end
        frameCounter = 0
        nextAutoRefresh = os.clock() + 10
        nextShipScan = 0
        espConn = RunService.RenderStepped:Connect(updateESP)
    end

    function stopESP()
        if espConn then espConn:Disconnect(); espConn = nil end
    end

    function refreshRender()
        if espEnabled or vehEnabled or shipEnabled or wantedEspEnabled or NpcSys.Enabled or ShipSys.Tracer then
            startESP()
        else
            stopESP()
        end
    end

