            c.bl2.From, c.bl2.To, c.bl2.Color, c.bl2.Thickness, c.bl2.Visible = Vector2.new(topX, topY + height), Vector2.new(topX, topY + height - lenY), color, 1.5, true
            c.br1.From, c.br1.To, c.br1.Color, c.br1.Thickness, c.br1.Visible = Vector2.new(topX + width, topY + height), Vector2.new(topX + width - lenX, topY + height), color, 1.5, true
            c.br2.From, c.br2.To, c.br2.Color, c.br2.Thickness, c.br2.Visible = Vector2.new(topX + width, topY + height), Vector2.new(topX + width, topY + height - lenY), color, 1.5, true
        else
            for _, key in ipairs(LINE_KEYS) do
                if c[key] then c[key].Visible = false end
            end
        end

        if showHealth then
            local maxHealth = math.max(hum.MaxHealth, 1)
            local hp = math.clamp(hum.Health / maxHealth, 0, 1)
            local bw = 3
            c.healthBg.Size, c.healthBg.Position, c.healthBg.Visible = Vector2.new(bw, height), Vector2.new(topX - bw - 2, topY), true
            c.healthFill.Size, c.healthFill.Position, c.healthFill.Color, c.healthFill.Visible = Vector2.new(bw, height * hp), Vector2.new(topX - bw - 2, topY + height * (1 - hp)), Color3.fromRGB(255 * (1 - hp), 255 * hp, 0), true
        else
            c.healthBg.Visible, c.healthFill.Visible = false, false
        end

        if showNames then
