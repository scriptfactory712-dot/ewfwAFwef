-- функция логирования (systemd-style: [ OK ], [ .. ], [FAIL])
local logLines = {}
local function pushLog(text, status)
    status = status or "OK"
    local color = "00dc6e"
    if status == ".." then color = "dcb000"
    elseif status == "FAIL" then color = "dc3232"
    end
    local line = string.format(
        '<font color="#444">[</font> <font color="#%s">%s</font> <font color="#444">]</font> %s',
        color, status, text
    )
    table.insert(logLines, line)
    if #logLines > 7 then table.remove(logLines, 1) end
    if logLabel and logLabel.Parent then
        logLabel.Text = table.concat(logLines, "\n")
    end
end

local function Update(text, progress, status)
    pushLog(text, status or (progress >= 1.0 and "OK" or ".."))
    if percentText and percentText.Parent then
        percentText.Text = math.floor(progress * 100 + 0.5) .. "%"
    end
    pcall(function()
        TweenService:Create(barFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad),
            { Size = UDim2.new(progress, 0, 1, 0) }):Play()
    end)
end

