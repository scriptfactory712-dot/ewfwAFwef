    function getFactionSources(player)
        local parts = {}
        if player.Team then table.insert(parts, player.Team.Name) end
        for _, obj in ipairs(player:GetChildren()) do
            if obj:IsA("StringValue") then table.insert(parts, obj.Name) table.insert(parts, obj.Value) end
        end
        for k, v in pairs(player:GetAttributes()) do table.insert(parts, k) table.insert(parts, tostring(v)) end
        local ls = player:FindFirstChild("leaderstats")
        if ls then for _, v in ipairs(ls:GetChildren()) do table.insert(parts, v.Name) if v:IsA("ValueBase") then table.insert(parts, tostring(v.Value)) end end end
        local char = player.Character
        if char then for k, v in pairs(char:GetAttributes()) do table.insert(parts, k) table.insert(parts, tostring(v)) end end
        return table.concat(parts, " "):lower()
    end

    function computeFaction(player)
        local blob = getFactionSources(player)
        for _, id in ipairs(PRIORITY) do
            local f = factionById[id]
            for _, key in ipairs(f.keys) do if blob:find(key, 1, true) then return id end end
        end
        return "Civilian"
    end

    function getFaction(player)
        local cached = factionCache[player]
