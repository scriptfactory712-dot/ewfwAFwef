    -- Boat Smuggling, торговцы и т.п.) — Model + Humanoid в workspace без привязки к игроку.
    -- Весь NPC-слой в одной таблице (лимит 200 регистров чанка).
    local NpcSys = {
        Enabled = false, ShowNames = true,
