    -- ========== WANTED LEVEL ДЕТЕКТОР ==========
    -- расширенный список ключей + поддержка кастомных имён через recon
    local WANTED_KEYS = {
        "wantedlevel", "wanted", "stars", "star", "crimelevel", "crime",
        "searchlevel", "bounty", "heat", "wantedstars", "wl", "wanted_level",
        "starcount", "star_count", "arrestlevel", "arrest", "notoriety",
        "infamy", "dangerlevel", "threatlevel", "wantedlvl", "suspicion",
        -- FIX Wanted: реальные имена из San Diego Border + общие варианты
        "warrant", "warrants", "felony", "criminal", "outlaw", "mostwanted",
        "most_wanted", "iswanted", "haswanted", "wantedstatus", "wanted_status",
        "crimepoints", "heatlevel", "copheat", "policeheat", "jail", "prison",
    }
    local CRIMINAL_WORDS = {
        "wanted", "criminal", "outlaw", "fugitive", "suspect",
        "преступник", "разыскивается", "розыск"
    }

    -- сюда recon-кнопка может дописать найденные имена
    local WANTED_CUSTOM_KEYS = {}

    local wantedCache = {}

    -- parseWantedValue/checkKeyMatch: вынесены на уровень чанка (лимит 200 регистров)
    function computeWantedLevel(player)
        local level = 0
        local allKeys = WANTED_KEYS
        if #WANTED_CUSTOM_KEYS > 0 then
            allKeys = {}
            for _, k in ipairs(WANTED_KEYS) do table.insert(allKeys, k) end
            for _, k in ipairs(WANTED_CUSTOM_KEYS) do table.insert(allKeys, k) end
        end

        -- 1. атрибуты игрока
        for k, v in pairs(player:GetAttributes()) do
            if checkKeyMatch(k, allKeys) then
                local parsed = parseWantedValue(v)
                if parsed > level then level = parsed end
            end
        end

        -- 2. leaderstats
        local ls = player:FindFirstChild("leaderstats")
        if ls then
            for _, stat in ipairs(ls:GetChildren()) do
                if stat:IsA("ValueBase") then
                    if checkKeyMatch(stat.Name, allKeys) then
                        local parsed = parseWantedValue(stat.Value)
                        if parsed > level then level = parsed end
                    end
                end
            end
        end

        -- 3. прямые дети игрока (любой ValueBase, включая BoolValue "Wanted"=true)
        for _, obj in ipairs(player:GetChildren()) do
            if obj:IsA("ValueBase") then
                if checkKeyMatch(obj.Name, allKeys) then
                    local parsed = parseWantedValue(obj.Value)
                    if parsed > level then level = parsed end
                end
            end
        end

        -- 4. вложенные папки внутри игрока (один уровень)
        for _, folder in ipairs(player:GetChildren()) do
            if folder:IsA("Folder") or folder:IsA("Configuration") or folder:IsA("BillboardGui") then
                for _, obj in ipairs(folder:GetChildren()) do
                    if obj:IsA("ValueBase") then
                        if checkKeyMatch(obj.Name, allKeys) then
                            local parsed = parseWantedValue(obj.Value)
                            if parsed > level then level = parsed end
                        end
                    end
                end
            end
        end

        -- 5. атрибуты персонажа
        local char = player.Character
        if char then
            for k, v in pairs(char:GetAttributes()) do
                if checkKeyMatch(k, allKeys) then
                    local parsed = parseWantedValue(v)
                    if parsed > level then level = parsed end
                end
            end

            -- В некоторых версиях игры wanted хранится только в BillboardGui
            -- над персонажем либо в глубоко вложенном ValueObject.
            -- FIX Wanted: считаем звёзды-картинки (ImageLabel "Star") и числа
            -- внутри Wanted-GUI (TextLabel "3" в BillboardGui "Wanted").
            local starImages = 0
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("ValueBase") and checkKeyMatch(obj.Name, allKeys) then
                    level = math.max(level, parseWantedValue(obj.Value))
                elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                    local text = tostring(obj.Text):lower()
                    local marker = checkKeyMatch(obj.Name, allKeys)
                    for _, word in ipairs(CRIMINAL_WORDS) do
                        if text:find(word, 1, true) then marker = true; break end
                    end
                    -- число внутри Wanted-GUI: поднимаемся на 3 уровня вверх
                    if not marker then
                        local p = obj.Parent
                        for _ = 1, 3 do
                            if p and p ~= char then
                                if checkKeyMatch(p.Name, allKeys) then marker = true break end
                                p = p.Parent
                            else
                                break
                            end
                        end
                    end
                    if marker then
                        level = math.max(level, math.max(1, parseWantedValue(text)))
                    else
                        local stars = 0
                        for _ in text:gmatch("[*★✦✧]") do stars = stars + 1 end
                        if stars > 0 then level = math.max(level, math.min(stars, 5)) end
                        -- голая цифра над головой ("3") без маркера — тоже звезда
                        local onlyNum = tonumber(text:match("^%s*(%d+)%s*$"))
                        if onlyNum and onlyNum >= 1 and onlyNum <= 5 then
                            local pp = obj.Parent
                            if pp and (pp:IsA("BillboardGui") or pp:IsA("Frame") or pp:IsA("ScreenGui")) then
                                level = math.max(level, math.floor(onlyNum))
                            end
                        end
                    end
                elseif obj:IsA("ImageLabel") then
                    -- звёзды-иконки: считаем видимые Star-картинки
                    local iname = tostring(obj.Name):lower()
                    if iname:find("star", 1, true) or checkKeyMatch(iname, allKeys) then
                        local vis = true
                        pcall(function() vis = obj.Visible and obj.ImageTransparency < 1 end)
                        if vis then starImages = starImages + 1 end
                    end
                end
            end
            if starImages > 0 then
                level = math.max(level, math.min(starImages, 5))
            end
        end

        -- Некоторые серверы обозначают преступников только командой/фракцией.
        local teamName = player.Team and player.Team.Name:lower() or ""
        for _, word in ipairs(CRIMINAL_WORDS) do
            if teamName:find(word, 1, true) then
                level = math.max(level, 1)
                break
            end
        end

        return level
    end

    function getWantedLevel(player)
        local cached = wantedCache[player]
        if cached and os.clock() - cached.time < 0.5 then return cached.level end
        local result = computeWantedLevel(player)
