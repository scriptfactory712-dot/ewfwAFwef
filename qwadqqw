    -- ========== КОРАБЛЬ: Tracer Lines + видно отовсюду ==========
    -- Линия от центра экрана к судну + дистанция (сквозь стены, Drawing).
    -- Если модель выгружена стримингом — позицию берём из игрового маркера "N STUDS".
    local ShipSys = { Tracer = false, Line = nil, Text = nil, MarkLabel = nil }

    function shipFindMarker()
        local lbl = ShipSys.MarkLabel
        if lbl and lbl.Parent then return lbl end
        ShipSys.MarkLabel = nil
        local ok, all = pcall(function() return workspace:GetDescendants() end)
        if not ok or not all then return nil end
        for _, v in ipairs(all) do
            if v:IsA("TextLabel") or v:IsA("TextButton") then
                local t = ""
                pcall(function() t = tostring(v.Text) end)
                if string.find(string.lower(t), "studs", 1, true) then
                    local blob = string.lower(t .. " " .. v:GetFullName())
                    if blob:find("ship", 1, true) or blob:find("boat", 1, true)
                        or blob:find("liner", 1, true) or blob:find("crest", 1, true)
                        or blob:find("cargo", 1, true) then
                        ShipSys.MarkLabel = v
                        return v
                    end
                end
            end
        end
        return nil
    end

    function shipMarkerPos()
        local lbl = shipFindMarker()
        if not lbl then return nil end
        local node = lbl
        for _ = 1, 6 do
            if not node then return nil end
            if node:IsA("BasePart") then return node.Position end
            if node:IsA("BillboardGui") then
                local ad = nil
                pcall(function() ad = node.Adornee end)
                if ad and ad:IsA("BasePart") then return ad.Position end
            end
            node = node.Parent
        end
        return nil
    end

    function shipCenterPos()
        if shipModel and shipModel.Parent then
            local ok, cf = pcall(function() return shipModel:GetBoundingBox() end)
            if ok and cf then return cf.Position end
            local pp = nil
            pcall(function() pp = shipModel.PrimaryPart end)
            if pp then return pp.Position end
        end
        return shipMarkerPos()
    end

    function shipTracerHide()
        if ShipSys.Line then pcall(function() ShipSys.Line.Visible = false end) end
        if ShipSys.Text then pcall(function() ShipSys.Text.Visible = false end) end
    end

    function shipTracerUpdate(camPos, halfX, halfY)
        if not ShipSys.Tracer or not drawingSupported then
            shipTracerHide()
            return
        end
        local pos = shipCenterPos()
        if not pos then shipTracerHide() return end
        local cam = Camera or workspace.CurrentCamera
        if not cam then shipTracerHide() return end
        if not ShipSys.Line or not ShipSys.Text then
            pcall(function()
                if not ShipSys.Line then
                    ShipSys.Line = Drawing.new("Line")
                    ShipSys.Line.Thickness = 1.5
                    ShipSys.Line.Color = Color3.fromRGB(255, 60, 60)
                end
                if not ShipSys.Text then
                    ShipSys.Text = Drawing.new("Text")
                    ShipSys.Text.Size = 13
                    ShipSys.Text.Center = true
                    ShipSys.Text.Outline = true
                    ShipSys.Text.Color = Color3.fromRGB(255, 80, 80)
                end
            end)
        end
        local dist = math.floor((pos - camPos).Magnitude)
        local sp, on = cam:WorldToViewportPoint(pos)
        local ex, ey = sp.X, sp.Y
        if not on or sp.Z <= 0 then
            local dx, dy = sp.X - halfX, sp.Y - halfY
            local m = math.max(math.abs(dx), math.abs(dy), 1)
            ex, ey = halfX + dx / m * halfX * 0.95, halfY + dy / m * halfY * 0.95
        end
        pcall(function()
            ShipSys.Line.From = Vector2.new(halfX, halfY)
            ShipSys.Line.To = Vector2.new(ex, ey)
            ShipSys.Line.Visible = true
            ShipSys.Text.Text = "SHIP " .. dist .. " m"
            ShipSys.Text.Position = Vector2.new(ex, ey - 18)
            ShipSys.Text.Visible = true
        end)
    end

