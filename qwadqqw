    function addPlayerConnection(player, connection)
        local connections = playerConnections[player]
        if not connections then
            connections = {}
            playerConnections[player] = connections
        end
        table.insert(connections, connection)
    end

    function bindPlayerInvalidation(player)
        addPlayerConnection(player, player.CharacterAdded:Connect(function(char)
            invalidateFaction(player)
            invalidateWanted(player)
            if char then
                addPlayerConnection(player, char.AttributeChanged:Connect(function()
                    invalidateFaction(player)
                    invalidateWanted(player)
                end))
            end
        end))
        addPlayerConnection(player, player:GetPropertyChangedSignal("Team"):Connect(function()
            invalidateFaction(player)
        end))
        -- Faction and wanted data may be stored in arbitrary attributes, so do
        -- not rely on a short, hard-coded list of names for cache invalidation.
        addPlayerConnection(player, player.AttributeChanged:Connect(function()
            invalidateFaction(player)
            invalidateWanted(player)
        end))
        -- FIX 2: invalidate faction + wanted when player children change
        -- (StringValue "Faction" / IntValue "Wanted" added at runtime etc.)
        addPlayerConnection(player, player.ChildAdded:Connect(function(child)
            if child:IsA("ValueBase") then
                invalidateFaction(player)
                invalidateWanted(player)
                addPlayerConnection(player, child.Changed:Connect(function()
                    invalidateFaction(player)
                    invalidateWanted(player)
                end))
            end
            if child.Name == "leaderstats" and child:IsA("Folder") then
                for _, stat in ipairs(child:GetChildren()) do
                    if stat:IsA("ValueBase") then
                        addPlayerConnection(player, stat.Changed:Connect(function()
                            invalidateFaction(player)
                            invalidateWanted(player)
                        end))
                    end
                end
                addPlayerConnection(player, child.ChildAdded:Connect(function(s)
                    if s:IsA("ValueBase") then
                        addPlayerConnection(player, s.Changed:Connect(function()
                            invalidateFaction(player)
                            invalidateWanted(player)
                        end))
                    end
                end))
            end
        end))
        addPlayerConnection(player, player.ChildRemoved:Connect(function()
            invalidateFaction(player)
            invalidateWanted(player)
        end))
        -- bind to existing leaderstats children
        local ls = player:FindFirstChild("leaderstats")
        if ls then
            for _, stat in ipairs(ls:GetChildren()) do
                if stat:IsA("ValueBase") then
                    addPlayerConnection(player, stat.Changed:Connect(function()
                        invalidateFaction(player)
                        invalidateWanted(player)
                    end))
                end
            end
        end
        -- character attribute changes
        local char = player.Character
        if char then
            addPlayerConnection(player, char.AttributeChanged:Connect(function()
                invalidateFaction(player)
                invalidateWanted(player)
            end))
        end
    end

    playerAddedConn = Players.PlayerAdded:Connect(bindPlayerInvalidation)
    for _, plr in ipairs(Players:GetPlayers()) do
