            end
        else
            for _, key in ipairs(LINE_KEYS) do if c[key] then c[key].Visible = false end end
            if c.fullBox then c.fullBox.Visible = false end
            if c.box2dBg then c.box2dBg.Visible = false end
            if c.box2dOutline then c.box2dOutline.Visible = false end
        end

        -- === HEALTH ===
        if wShowHealth then
            local maxHealth = math.max(hum.MaxHealth, 1)
            local hp = math.clamp(hum.Health / maxHealth, 0, 1)
            local bw = 3
            c.healthBg.Size, c.healthBg.Position, c.healthBg.Visible = Vector2.new(bw, height), Vector2.new(topX - bw - 2, topY), true
            c.healthFill.Size, c.healthFill.Position, c.healthFill.Color, c.healthFill.Visible = Vector2.new(bw, height * hp), Vector2.new(topX - bw - 2, topY + height * (1 - hp)), Color3.fromRGB(255 * (1 - hp), 255 * hp, 0), true
        else
            c.healthBg.Visible, c.healthFill.Visible = false, false
        end

        -- === NAMES ===
        if wShowNames then
            local txt = player.Name
            c.name.Text, c.name.Position, c.name.Color, c.name.Visible = txt, Vector2.new(midX, topY - 20), finalColor, true
            local estW = estimateTextWidth(txt, 14) + 6
            c.nameBg.Size, c.nameBg.Position, c.nameBg.Transparency, c.nameBg.Visible = Vector2.new(estW, 18), Vector2.new(midX - estW / 2, topY - 22), 0.4, true
        else
            c.name.Visible, c.nameBg.Visible = false, false
        end

        -- === STARS ===
        if wShowStars then
            local starStr = ""
            for i = 1, wl do starStr = starStr .. "★" end
            for i = wl + 1, 5 do starStr = starStr .. "☆" end
            c.stars.Text = starStr
            c.stars.Position = Vector2.new(midX, topY - 36)
            c.stars.Color = finalColor
            c.stars.Visible = true
        else
            c.stars.Visible = false
        end

        -- === FACTION TAG ===
        if wShowFaction then
            c.factionTag.Text = "[" .. faction .. "]"
            c.factionTag.Position = Vector2.new(midX, topY - 50)
            c.factionTag.Color = factionById[faction].color
            c.factionTag.Visible = true
        else
            c.factionTag.Visible = false
        end

        -- === WEAPON ===
        if wShowWeapon then
            local wpn = getPlayerWeapon(player)
            if wpn then
                c.weapon.Text = "⚔ " .. wpn
                c.weapon.Position = Vector2.new(midX, topY + height + 16)
                c.weapon.Color = Color3.fromRGB(255, 200, 100)
                c.weapon.Visible = true
            else
                c.weapon.Visible = false
            end
        else
            c.weapon.Visible = false
        end

        -- === DISTANCE ===
        if wShowDistance then
            c.dist.Text = math.floor(distance) .. " m"
            c.dist.Position = Vector2.new(midX, topY + height + 2)
            c.dist.Color = finalColor
            c.dist.Visible = true
        else
            c.dist.Visible = false
        end

        -- === TRACERS ===
        if wShowTracers then
            c.tracer.From = Vector2.new(halfVpX, halfVpY)
            c.tracer.To = Vector2.new(botV.X, botV.Y)
            c.tracer.Color = finalColor
            c.tracer.Thickness = wTracerThickness
            c.tracer.Visible = true
        else
            c.tracer.Visible = false
        end

        -- === CHAMS ===
        if wShowChams then
            local hl = c.highlight
            if not hl or hl.Parent ~= char then
                if hl then pcall(instDestroy, hl) end
                local newHl = createHighlight(char, finalColor, 0.4)
                if newHl then pcall(hlEnable, newHl); c.highlight = newHl end
            elseif wRainbow or hl.FillColor ~= finalColor then
                pcall(hlColor, hl, finalColor)
            end
        else
            if c.highlight then pcall(instDestroy, c.highlight); c.highlight = nil end
        end
    end

    function updateWantedESP(camPos, halfVpX, halfVpY)
        if not wantedEspEnabled then return end
