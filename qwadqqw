                        print(string.format("[%d] %s | display=%s | npc=%s",
                            shown, v:GetFullName(), dn, tostring(npcNameOk(v, hum))))
                    end
                end
            end
        end
        print("=========== END (" .. shown .. ") ===========")
        Notify("NPC Recon", "Дамп в F9. Гуманоидов: " .. shown, 4)
    end

    function npcUpdateEsp(camPos)
        npcScanAsync()
        local cam = Camera or workspace.CurrentCamera
        if not cam then return end
        for model, d in pairs(NpcSys.Cache) do
            local alive = model.Parent and d.hum and d.hum.Parent and d.hum.Health > 0
                and d.root and d.root.Parent
            if not alive then
                npcRemove(model)
            elseif not NpcSys.Enabled then
                npcHideEntry(d)
            else
                local dist = (d.root.Position - camPos).Magnitude
                if dist > NpcSys.MaxDist then
                    npcHideEntry(d)
                else
                    local sp, on = cam:WorldToViewportPoint(d.root.Position)
                    if not on or sp.Z <= 0 then
                        npcHideEntry(d)
                    else
                        if not d.hl or not d.hl.Parent then
                            local okHl, hl = pcall(createHighlight, model, NpcSys.Color, 0.5, 0)
                            if okHl and hl then d.hl = hl end
                        end
                        if d.hl then pcall(hlEnable, d.hl) end
                        if NpcSys.ShowNames and d.gui and d.nameL and d.distL then
                            local label = model.Name
                            pcall(function()
                                local dn = d.hum.DisplayName
                                if type(dn) == "string" and dn ~= "" and dn ~= model.Name then
                                    label = dn
                                end
                            end)
                            d.nameL.Text = "🤖 " .. label
                            d.distL.Text = math.floor(dist) .. " m"
                            pcall(function() d.gui.Enabled = true end)
                        elseif d.gui then
                            pcall(function() d.gui.Enabled = false end)
                        end
                    end
                end
            end
        end
    end

    -- ========== BORDER GATE ANTI-COLLISION (рабочий метод из mainV2) ==========
    -- Барьеры определяются по CollisionGroup "GateBarrier" (+ тег "Gate"),
    -- проезд — через NoCollisionConstraint между моими деталями и барьером.
    -- CanCollide не трогаем: игра его переподтверждает. Стейт в одной таблице.
    local AntiSys = {
        Enabled = false, Invisible = true, Fence = false, Speed = false,
        AFK = false, AFKConn = nil, VU = nil,
        Players = false, PConstraints = {},
        Arrest = false, WasRagdoll = false, LastBlink = 0, BlinkSide = false,
        Cuffs = false, Drown = false, DrownCands = {},
        StatusRef = nil, LastMult = nil, SpdStatusRef = nil,
        Recoil = false, RecoilGun = nil, RecoilSaved = {},
        RecoilCam = nil, RecoilOrigImpulse = nil, RecoilOrigSpring = nil,
        RecoilImpFn = nil, RecoilSpringFn = nil, RecoilReal = nil,
        Constraints = {}, -- [constraint] = true
        InvisCache = {}, -- [BasePart] = origTransparency
        FenceCache = {}, -- [BasePart] = {cc, tr}
        SpeedCfg = nil, SpeedOrig = nil, SpeedPatched = nil,
        BoostCache = {}, -- [vehicle] = {top, power}
        BoostVeh = nil,
        BoostMult = 200, -- % множитель скорости машины
        Car400 = false, Bike400 = false, All400 = false,
        Stab = nil, StabOn = false,
        BarrierList = {}, FenceList = {},
        ScanId = 0, AddedConn = nil,
        FenceKw = {"fence", "mesh", "chainlink", "barricade", "palisade", "borderwall", "wirefence", "gate",
            "curb", "kerb", "divider", "median", "barrier", "jersey", "roadblock"},
        Cats = {
            Sheets = { On = false, Kw = {"sheet", "corrugated", "metalwall", "wallpanel", "metalfence", "wall", "borderwall"}, List = {}, Cache = {} },
            Lamps = { On = false, Kw = {"lamp", "streetlight", "lightpole", "lamppost", "lantern", "floodlight", "spotlight"}, List = {}, Cache = {} },
            Posts = { On = false, Kw = {"post", "pole", "bollard", "pillar", "column", "pylon", "mast", "utility", "telephone", "electric", "powerline", "cable"}, List = {}, Cache = {} },
        },
        CS = nil,
    }

    function antiCS()
        if not AntiSys.CS then
            pcall(function()
                AntiSys.CS = game:GetService("CollectionService")
            end)
        end
        return AntiSys.CS
    end

    function antiIsBarrier(part)
        if not part or not part.Parent then return false end
        if not part:IsA("BasePart") then return false end
        local ok, group = pcall(function() return part.CollisionGroup end)
        if ok and group == "GateBarrier" then return true end
        local cs = antiCS()
        if cs then
            local node = part
            for _ = 1, 5 do
                if not node or node == workspace then break end
                local okT, tagged = pcall(function() return cs:HasTag(node, "Gate") end)
                if okT and tagged then return true end
                node = node.Parent
            end
        end
        return false
    end

    function antiCollectBarriers()
        local parts, seen = {}, {}
        local function push(p)
            if p and p.Parent and not seen[p] then
                seen[p] = true
                table.insert(parts, p)
            end
        end
        local cs = antiCS()
        if cs then
            local ok, tagged = pcall(function() return cs:GetTagged("Gate") end)
            if ok and tagged then
                for _, gate in ipairs(tagged) do
                    if gate:IsDescendantOf(workspace) then
                        if gate:IsA("BasePart") and antiIsBarrier(gate) then push(gate) end
                        local okD, desc = pcall(function() return gate:GetDescendants() end)
                        if okD and desc then
                            for _, d in ipairs(desc) do
                                if d:IsA("BasePart") and antiIsBarrier(d) then push(d) end
                            end
                        end
                    end
                end
            end
        end
        if #parts == 0 then
            local ok, all = pcall(function() return workspace:GetDescendants() end)
            if ok and all then
                for _, o in ipairs(all) do
                    if o:IsA("BasePart") and antiIsBarrier(o) then push(o) end
                end
            end
        end
        return parts
    end

    function antiGetVehicle()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local seat = hum and hum.SeatPart or nil
        if not seat then return nil end
        local vehicles = nil
        pcall(function() vehicles = workspace:FindFirstChild("Vehicles") end)
        if vehicles then
            local object = seat
            while object and object.Parent ~= vehicles do
                object = object.Parent
            end
            if object and object.Parent == vehicles and object:IsA("Model") then
                return object
            end
        end
        local fallback = nil
        pcall(function() fallback = seat:FindFirstAncestorOfClass("Model") end)
        if fallback and not Players:GetPlayerFromCharacter(fallback) then
            return fallback
        end
        return nil
    end

    function antiMyParts()
        local parts, seen = {}, {}
        local function push(p)
            if p and p:IsA("BasePart") and p.Parent and not seen[p] then
                seen[p] = true
                table.insert(parts, p)
            end
        end
        local vehicle = antiGetVehicle()
        if vehicle then
            local body = vehicle:FindFirstChild("Body")
            if body then
                local col = body:FindFirstChild("Colliders")
                if col then
                    for _, o in ipairs(col:GetDescendants()) do push(o) end
                end
                local trailer = body:FindFirstChild("Trailer")
                if trailer then
                    local tcol = trailer:FindFirstChild("Colliders")
                    if tcol then
                        for _, o in ipairs(tcol:GetDescendants()) do push(o) end
                    end
                    local tw = trailer:FindFirstChild("Wheels")
                    if tw then
                        for _, w in ipairs(tw:GetChildren()) do
                            local c = w:FindFirstChild("Collider")
                            if c then push(c) end
                        end
                    end
                end
            end
            local wheels = vehicle:FindFirstChild("Wheels")
            if wheels then
                for _, w in ipairs(wheels:GetChildren()) do
                    local c = w:FindFirstChild("Collider")
                    if c then push(c) end
                end
            end
            local root = vehicle.PrimaryPart or vehicle:FindFirstChild("Root")
            if root then push(root) end
            if #parts == 0 then
                -- нестандартная структура: берём весь кузов
                for _, o in ipairs(vehicle:GetDescendants()) do push(o) end
            end
        end
        local char = LocalPlayer.Character
        if char then
            for _, o in ipairs(char:GetDescendants()) do push(o) end
        end
        return parts
    end

    function antiClearConstraints()
        for c in pairs(AntiSys.Constraints) do
            AntiSys.Constraints[c] = nil
            pcall(function()
                if c.Parent then c:Destroy() end
            end)
        end
        table.clear(AntiSys.Constraints)
    end

    function antiApplyInvis(barrierParts)
        if AntiSys.Invisible then
            for _, p in ipairs(barrierParts) do
                if AntiSys.InvisCache[p] == nil then
                    AntiSys.InvisCache[p] = p.Transparency
                end
                pcall(function() p.Transparency = 1 end)
            end
        else
            for p, tr in pairs(AntiSys.InvisCache) do
                pcall(function()
                    if p.Parent then p.Transparency = tr end
                end)
            end
            table.clear(AntiSys.InvisCache)
        end
    end

    function antiRestoreInvis()
        for p, tr in pairs(AntiSys.InvisCache) do
            pcall(function()
                if p.Parent then p.Transparency = tr end
            end)
        end
        table.clear(AntiSys.InvisCache)
    end

    -- Пограничный забор/сетка-ворота: именного детекта (своё имя + 3 предка),
    -- только рядом с игроком (250м). Коллизию снимаем напрямую — забор не скриптован.
    function antiFenceMatch(inst)
        local blobs = { string.lower(inst.Name) }
        local node = inst.Parent
        for _ = 1, 3 do
            if not node or node == workspace then break end
            table.insert(blobs, string.lower(node.Name))
            node = node.Parent
        end
        for _, blob in ipairs(blobs) do
            for _, kw in ipairs(AntiSys.FenceKw) do
                if string.find(blob, kw, 1, true) then return true end
            end
        end
        return false
    end

    function antiInVehicleModel(inst)
        local node = inst.Parent
        while node and node ~= workspace and node ~= game do
            if node:IsA("Model") then
                if node:FindFirstChildWhichIsA("VehicleSeat", true) then return true end
                if Players:GetPlayerFromCharacter(node) then return true end
            end
            node = node.Parent
        end
        return false
    end

    -- Скан ОДИН раз при включении + добивка через DescendantAdded.
    -- Периодических полных сканов нет — именно они давали просадки кадров.
    function antiWatchAdded()
        if AntiSys.AddedConn then return end
        local ok, conn = pcall(function()
            return workspace.DescendantAdded:Connect(function(v)
                if hubDestroyed or not AntiSys.Enabled then return end
                task.defer(function()
                    if hubDestroyed or not AntiSys.Enabled then return end
                    if v:IsA("BasePart") then
                        if antiIsBarrier(v) then
                            table.insert(AntiSys.BarrierList, v)
                        elseif AntiSys.Fence and antiFenceMatch(v) and not antiInVehicleModel(v) then
                            table.insert(AntiSys.FenceList, v)
                        end
                    end
                end)
            end)
        end)
        if ok and conn then AntiSys.AddedConn = conn end
    end

    function antiScanBarriersNow()
        if not AntiSys.Enabled then return end
        AntiSys.BarrierList = antiCollectBarriers()
    end

    function antiScanFencesChunked()
        AntiSys.ScanId = AntiSys.ScanId + 1
        local myId = AntiSys.ScanId
        table.clear(AntiSys.FenceList)
        task.spawn(function()
            local ok, all = pcall(function() return workspace:GetDescendants() end)
            if not ok or not all then return end
            local n = #all
            local i = 1
            while i <= n and not hubDestroyed and AntiSys.Enabled and AntiSys.Fence
                and AntiSys.ScanId == myId do
                local t0 = os.clock()
                while i <= n do
                    local o = all[i]
                    i = i + 1
                    if o:IsA("BasePart") and antiFenceMatch(o) and not antiInVehicleModel(o) then
                        table.insert(AntiSys.FenceList, o)
                    end
                    if os.clock() - t0 >= 0.004 then break end
                end
                task.wait()
            end
        end)
    end

    function antiApplyFences()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local center = root and root.Position or nil
        for _, p in ipairs(AntiSys.FenceList) do
            if p.Parent and (not center or (p.Position - center).Magnitude <= 250) then
                local s = AntiSys.FenceCache[p]
                if s == nil then
                    s = { cc = p.CanCollide, tr = p.Transparency }
                    AntiSys.FenceCache[p] = s
                end
                pcall(function() p.CanCollide = false end)
                pcall(function()
                    p.Transparency = AntiSys.Invisible and 1 or s.tr
                end)
            end
        end
        for p in pairs(AntiSys.FenceCache) do
            if not p.Parent then AntiSys.FenceCache[p] = nil end
        end
    end

    function antiRestoreFences()
        for p, s in pairs(AntiSys.FenceCache) do
            pcall(function()
                if p.Parent then
                    p.CanCollide = s.cc
                    p.Transparency = s.tr
                end
            end)
        end
        table.clear(AntiSys.FenceCache)
    end

    -- Раздельные удалялки: листы / фонари / столбы. У каждой свой список слов,
    -- свой кэш и свой тогл. Механизм как у заборов: рядом (250м), без коллизии.
    function antiCatMatch(inst, cat)
        local blobs = { string.lower(inst.Name) }
        local node = inst.Parent
        for _ = 1, 3 do
            if not node or node == workspace then break end
            table.insert(blobs, string.lower(node.Name))
            node = node.Parent
        end
        for _, blob in ipairs(blobs) do
            for _, kw in ipairs(cat.Kw) do
                if string.find(blob, kw, 1, true) then return true end
            end
        end
        return false
    end

    function antiCatScan(name)
        local cat = AntiSys.Cats[name]
        if not cat then return end
        AntiSys.ScanId = AntiSys.ScanId + 1
        local myId = AntiSys.ScanId
        table.clear(cat.List)
        task.spawn(function()
            local ok, all = pcall(function() return workspace:GetDescendants() end)
            if not ok or not all then return end
            local n = #all
            local i = 1
            while i <= n and not hubDestroyed and cat.On and AntiSys.ScanId == myId do
                local t0 = os.clock()
                while i <= n do
                    local o = all[i]
                    i = i + 1
                    if o:IsA("BasePart") and antiCatMatch(o, cat) and not antiInVehicleModel(o) then
                        table.insert(cat.List, o)
                    end
                    if os.clock() - t0 >= 0.004 then break end
                end
                task.wait()
            end
        end)
    end

    function antiCatApply(name)
        local cat = AntiSys.Cats[name]
        if not cat or not cat.On then return end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local center = root and root.Position or nil
        for _, p in ipairs(cat.List) do
            if p.Parent and (not center or (p.Position - center).Magnitude <= 250) then
                local s = cat.Cache[p]
                if s == nil then
                    s = { cc = p.CanCollide, tr = p.Transparency }
                    cat.Cache[p] = s
                end
                pcall(function() p.CanCollide = false end)
                pcall(function()
                    p.Transparency = AntiSys.Invisible and 1 or s.tr
                end)
            end
        end
        for p in pairs(cat.Cache) do
            if not p.Parent then cat.Cache[p] = nil end
        end
    end

    function antiCatRestore(name)
        local cat = AntiSys.Cats[name]
        if not cat then return end
        for p, s in pairs(cat.Cache) do
            pcall(function()
                if p.Parent then
                    p.CanCollide = s.cc
                    p.Transparency = s.tr
                end
            end)
        end
        table.clear(cat.Cache)
    end

    function antiReconcile()
        local myParts = antiMyParts()
        local barrierParts = AntiSys.BarrierList
        if AntiSys.Fence then antiApplyFences() end
        for name in pairs(AntiSys.Cats) do antiCatApply(name) end
        if #myParts == 0 or #barrierParts == 0 then
            antiClearConstraints()
            return
        end
        antiApplyInvis(barrierParts)
        local desired = {}
        for _, myPart in ipairs(myParts) do
            if myPart.Parent then
                local map = desired[myPart]
                if not map then
                    map = {}
                    desired[myPart] = map
                end
                for _, bp in ipairs(barrierParts) do
                    if bp.Parent then map[bp] = true end
                end
            end
        end
        for c in pairs(AntiSys.Constraints) do
            local p0, p1 = c.Part0, c.Part1
            local map = p0 and desired[p0]
            if not map or not map[p1] then
                AntiSys.Constraints[c] = nil
                pcall(function()
                    if c.Parent then c:Destroy() end
                end)
            else
                map[p1] = nil
            end
        end
        for myPart, map in pairs(desired) do
            for bp in pairs(map) do
                pcall(function()
                    local con = Instance.new("NoCollisionConstraint")
                    con.Name = "__LuaHubGatePass"
                    con.Part0 = myPart
                    con.Part1 = bp
                    con.Parent = myPart
                    AntiSys.Constraints[con] = true
                end)
            end
        end
    end

    function antiDisable()
        antiClearConstraints()
        antiClearPConstraints()
        antiRestoreInvis()
        antiRestoreFences()
        antiSpeedRestore()
        antiStabClear()
        antiAFK(false)
        AntiSys.WasRagdoll = false
        for name in pairs(AntiSys.Cats) do antiCatRestore(name) end
        table.clear(AntiSys.BarrierList)
        table.clear(AntiSys.FenceList)
    end

    -- Anti Speed Limit (рабочий метод из mainV2): патчим ВСЕ регионы скорости
    -- в конфиге (Border + водные и прочие), а не только BorderSpeedLimitRegion.
    -- MaxMPH=10000000, тормоз-множитель 0, нотисы OFF.
    function antiSpeedApply()
        if AntiSys.SpeedPatched then return true end
        local rss = nil
        pcall(function() rss = game:GetService("ReplicatedStorage") end)
        local mod = rss and rss:FindFirstChild("SharedModules")
        mod = mod and mod:FindFirstChild("Configs")
        mod = mod and mod:FindFirstChild("RegionSpeedLimits")
        if not mod then return false end
        local ok, config = pcall(require, mod)
        if not ok or type(config) ~= "table" or type(config.Regions) ~= "table" then
            return false
        end
        local list = {}
        for key, region in pairs(config.Regions) do
            if type(region) == "table" and type(region.MaxMPH) == "number" then
                local cp = {}
                for k, v in pairs(region) do cp[k] = v end
                cp.MaxMPH = 10000000
                if cp.BrakeTorqueMultiplier ~= nil then cp.BrakeTorqueMultiplier = 0 end
                if cp.NotificationMessageFormat ~= nil then cp.NotificationMessageFormat = "" end
                if cp.NotificationDuration ~= nil then cp.NotificationDuration = 0 end
                if cp.NotificationMPHOffset ~= nil then cp.NotificationMPHOffset = 0 end
                local okW = pcall(function() config.Regions[key] = cp end)
                if okW then table.insert(list, { key = key, orig = region, patched = cp }) end
            end
        end
        if #list == 0 then return false end
        AntiSys.SpeedCfg, AntiSys.SpeedPatchList, AntiSys.SpeedPatched =
            config, list, true
        return true
    end

    function antiSpeedCheck()
        local cfg, list = AntiSys.SpeedCfg, AntiSys.SpeedPatchList
        if not cfg or type(cfg.Regions) ~= "table" or type(list) ~= "table" then
            return false
        end
        for _, e in ipairs(list) do
            if cfg.Regions[e.key] ~= e.patched then return false end
        end
        return true
    end

    function antiSpeedRestore()
        local cfg, list = AntiSys.SpeedCfg, AntiSys.SpeedPatchList
        if cfg and type(cfg.Regions) == "table" and type(list) == "table" then
            for _, e in ipairs(list) do
                if cfg.Regions[e.key] == e.patched then
                    pcall(function() cfg.Regions[e.key] = e.orig end)
                end
            end
        end
        AntiSys.SpeedCfg, AntiSys.SpeedPatchList, AntiSys.SpeedPatched = nil, nil, nil
        antiBoostRestore()
    end

    function antiSpeedTick()
        local vehicle = antiGetVehicle()
        -- Патч регионов нужен ВСЕМ скор. функциям (лодки тоже душат регионы).
        local wantConfig = AntiSys.Speed or (vehicle and antiSpeedTypeOn(vehicle))
        if wantConfig and not antiSpeedCheck() then
            antiSpeedApply()
        end
        local last = AntiSys.BoostVeh
        if last and last ~= vehicle then
            antiBoostRestoreOne(last)
        end
        AntiSys.BoostVeh = vehicle
        if vehicle then
            local mult = nil
            if antiSpeedTypeOn(vehicle) then
                -- у лодок часто нет Gears/MaxSpeed: тогда фикс x3, а не ноль
                mult = antiSpeed400Mult(vehicle) or 3
            elseif AntiSys.Speed then
                mult = math.clamp((AntiSys.BoostMult or 200) / 100, 1, 3)
            end
            if mult then
                antiBoostSet(vehicle, mult)
                AntiSys.LastMult = mult
            elseif AntiSys.BoostCache[vehicle] then
                antiBoostRestoreOne(vehicle)
                AntiSys.LastMult = nil
            end
        else
            AntiSys.LastMult = nil
        end
        if AntiSys.StabOn and vehicle and antiVehicleKind(vehicle) ~= "boat" then
            antiStabTick(vehicle)
        else
            antiStabClear()
        end
    end

    function antiBoostRestoreOne(vehicle)
        local saved = AntiSys.BoostCache[vehicle]
        if saved then
            pcall(function()
                if vehicle.Parent then
                    if saved.top == nil then
                        vehicle:SetAttribute("TopSpeedMultiplier", nil)
                    else
                        vehicle:SetAttribute("TopSpeedMultiplier", saved.top)
                    end
                    if saved.power == nil then
                        vehicle:SetAttribute("EnginePowerMultiplier", nil)
                    else
                        vehicle:SetAttribute("EnginePowerMultiplier", saved.power)
                    end
                end
            end)
            AntiSys.BoostCache[vehicle] = nil
        end
        if AntiSys.BoostVeh == vehicle then AntiSys.BoostVeh = nil end
    end

    -- Стабилизатор: прижимная сила от скорости + гашение крена/тангажа.
    -- Лечит тряску и "завод" на 200-300 км/ч.
    function antiStabTick(vehicle)
        if not vehicle or not vehicle.Parent then antiStabClear() return end
        local root = vehicle.PrimaryPart or vehicle:FindFirstChild("Root")
        if not root or not root.Parent then return end
        local st = AntiSys.Stab
        if not st or st.vehicle ~= vehicle or not st.force.Parent then
            antiStabClear()
            local att = Instance.new("Attachment")
            att.Name = "LuaHubStab"
            local force = Instance.new("VectorForce")
            force.Name = "LuaHubDownforce"
            force.RelativeTo = Enum.ActuatorRelativeTo.World
            force.Attachment0 = att
            att.Parent = root
            force.Parent = root
            st = { vehicle = vehicle, att = att, force = force }
            AntiSys.Stab = st
        end
        local speed = root.AssemblyLinearVelocity.Magnitude
        local mass = root.AssemblyMass
        if mass <= 0 then mass = 1000 end
        -- МЯГКО: было mass*120 (120 гравитаций!) — душило и трясло. Теперь до 12.
        local down = mass * math.clamp(speed * 0.06, 0, 12)
        pcall(function() st.force.Force = Vector3.new(0, -down, 0) end)
        pcall(function()
            local av = root.AssemblyAngularVelocity
            root.AssemblyAngularVelocity = Vector3.new(av.X * 0.85, av.Y, av.Z * 0.85)
        end)
    end

    function antiStabClear()
        local st = AntiSys.Stab
        AntiSys.Stab = nil
        if st then
            pcall(function() if st.force then st.force:Destroy() end end)
            pcall(function() if st.att then st.att:Destroy() end end)
        end
    end

    -- Тип транспорта по имени: boat / bike / car (по умолчанию car).
    function antiVehicleKind(vehicle)
        if not vehicle then return nil end
        local n = string.lower(vehicle.Name)
        local function has(list)
            for _, kw in ipairs(list) do
                if n:find(kw, 1, true) then return true end
            end
            return false
        end
        if has({"boat", "dinghy", "yacht", "ship", "ferry", "canoe", "kayak", "jetski", "submarine", "sail", "tug", "barge", "patrol"}) then
            return "boat"
        end
        if has({"bike", "moto", "scooter", "chopper"}) then
            return "bike"
        end
        return "car"
    end

    -- Стоковая максималка из Gears/MaxSpeed (миль/ч), как в mainV2.
    function antiStockMph(vehicle)
        local gears = vehicle and vehicle:FindFirstChild("Gears")
        local best = 0
        if gears then
            for _, gear in ipairs(gears:GetChildren()) do
                local ms = gear:GetAttribute("MaxSpeed")
                if type(ms) == "number" then best = math.max(best, math.abs(ms)) end
            end
        end
        if best > 0 then return best end
        return nil
    end

    function antiSpeedTypeOn(vehicle)
        if AntiSys.All400 then return true end
        local kind = antiVehicleKind(vehicle)
        if kind == "bike" and AntiSys.Bike400 then return true end
        if kind == "car" and AntiSys.Car400 then return true end
        return false
    end

    -- Множитель под цель 400 км/ч (249 миль/ч) от стока машины.
    function antiSpeed400Mult(vehicle)
        local stock = antiStockMph(vehicle)
        if not stock then return nil end
        return math.clamp(249 / stock, 1, 5)
    end

    -- Буст машины множителями (метод mainV2: TopSpeed/EnginePower, слайдер %).
    function antiBoostApply()
        local vehicle = antiGetVehicle()
        if not vehicle then return end
        antiBoostSet(vehicle, math.clamp((AntiSys.BoostMult or 200) / 100, 1, 3))
    end

    function antiBoostSet(vehicle, mult)
        if not vehicle then return end
        local saved = AntiSys.BoostCache[vehicle]
        if saved == nil then
            saved = { top = vehicle:GetAttribute("TopSpeedMultiplier"), power = vehicle:GetAttribute("EnginePowerMultiplier") }
            AntiSys.BoostCache[vehicle] = saved
        end
        local top = saved.top
        if type(top) ~= "number" or top <= 0 or top ~= top then top = 1 end
        local power = saved.power
        if type(power) ~= "number" or power <= 0 or power ~= power then power = 1 end
        pcall(function()
            vehicle:SetAttribute("TopSpeedMultiplier", top * mult)
            vehicle:SetAttribute("EnginePowerMultiplier", power * mult)
        end)
    end

    function antiBoostRestore()
        for vehicle, saved in pairs(AntiSys.BoostCache) do
            pcall(function()
                if vehicle.Parent then
                    if saved.top == nil then
                        vehicle:SetAttribute("TopSpeedMultiplier", nil)
                    else
                        vehicle:SetAttribute("TopSpeedMultiplier", saved.top)
                    end
                    if saved.power == nil then
                        vehicle:SetAttribute("EnginePowerMultiplier", nil)
                    else
                        vehicle:SetAttribute("EnginePowerMultiplier", saved.power)
                    end
                end
            end)
        end
        table.clear(AntiSys.BoostCache)
    end

    -- Anti-AFK: жмём виртуальную кнопку при Idled (метод из mainV1).
    function antiAFK(on)
        if on then
            if AntiSys.AFKConn then return end
            local vu = AntiSys.VU
            if not vu then
                pcall(function() vu = game:GetService("VirtualUser") end)
                AntiSys.VU = vu
            end
            if not vu then return end
            local ok, conn = pcall(function()
                return LocalPlayer.Idled:Connect(function()
                    pcall(function()
                        vu:CaptureController()
                        vu:ClickButton2(Vector2.new())
                    end)
                end)
            end)
            if ok and conn then AntiSys.AFKConn = conn end
        else
            if AntiSys.AFKConn then
                pcall(function() AntiSys.AFKConn:Disconnect() end)
                AntiSys.AFKConn = nil
            end
        end
    end

    -- Anti Player Collision: мои коллайдеры <-> коллайдеры ВСЕХ чужих машин
    -- из папки Vehicles (включая припаркованные без водителей!) + пешеходы рядом.
    -- Именно коллайдеры (Body/Colliders, Wheels/Collider), а не весь кузов.
    function antiOwnColliderParts()
        local parts, seen = {}, {}
        local function push(p)
            if p and p:IsA("BasePart") and p.Parent and not seen[p] then
                seen[p] = true
                table.insert(parts, p)
            end
        end
        local vehicle = antiGetVehicle()
        if vehicle then
            local body = vehicle:FindFirstChild("Body")
            if body then
                local col = body:FindFirstChild("Colliders")
                if col then
                    for _, o in ipairs(col:GetDescendants()) do push(o) end
                end
                local trailer = body:FindFirstChild("Trailer")
                if trailer then
                    local tcol = trailer:FindFirstChild("Colliders")
                    if tcol then
                        for _, o in ipairs(tcol:GetDescendants()) do push(o) end
                    end
                    local tw = trailer:FindFirstChild("Wheels")
                    if tw then
                        for _, w in ipairs(tw:GetChildren()) do
                            local c = w:FindFirstChild("Collider")
                            if c then push(c) end
                        end
                    end
                end
            end
            local wheels = vehicle:FindFirstChild("Wheels")
            if wheels then
                for _, w in ipairs(wheels:GetChildren()) do
                    local c = w:FindFirstChild("Collider")
                    if c then push(c) end
                end
            end
            local root = vehicle.PrimaryPart or vehicle:FindFirstChild("Root")
            if root then push(root) end
            if #parts == 0 then
                -- нестандартная структура: весь кузов, но не больше 80 деталей
                local n = 0
                for _, o in ipairs(vehicle:GetDescendants()) do
                    if o:IsA("BasePart") then
                        push(o)
                        n = n + 1
                        if n >= 80 then break end
                    end
                end
            end
        end
        local char = LocalPlayer.Character
        if char then
            for _, o in ipairs(char:GetDescendants()) do push(o) end
        end
        return parts
    end

    function antiTrafficParts()
        local out, seen = {}, {}
        local function push(p)
            if p and p:IsA("BasePart") and p.Parent and not seen[p] then
                seen[p] = true
                table.insert(out, p)
            end
        end
        local mine = antiGetVehicle()
        local vehicles = nil
        pcall(function() vehicles = workspace:FindFirstChild("Vehicles") end)
        if vehicles then
            for _, v in ipairs(vehicles:GetChildren()) do
                if v:IsA("Model") and v ~= mine then
                    local body = v:FindFirstChild("Body")
                    local added = false
                    if body then
                        local col = body:FindFirstChild("Colliders")
                        if col then
                            for _, o in ipairs(col:GetDescendants()) do push(o) end
                            added = true
                        end
                        if not added then
                            local n = 0
                            for _, o in ipairs(v:GetDescendants()) do
                                if o:IsA("BasePart") then
                                    push(o)
                                    n = n + 1
                                    if n >= 80 then break end
                                end
                            end
                        end
                    else
                        local n = 0
                        for _, o in ipairs(v:GetDescendants()) do
                            if o:IsA("BasePart") then
                                push(o)
                                n = n + 1
                                if n >= 80 then break end
                            end
                        end
                    end
                end
            end
        end
        -- пешеходы рядом (80м): голова + корпус
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            local center = root.Position
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Parent then
                    local ch = plr.Character
                    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                    if hrp and (hrp.Position - center).Magnitude <= 80 then
                        push(hrp)
                        local t = ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
                        if t then push(t) end
                    end
                end
            end
        end
        return out
    end

    function antiClearPConstraints()
        for c in pairs(AntiSys.PConstraints) do
            AntiSys.PConstraints[c] = nil
            pcall(function()
                if c.Parent then c:Destroy() end
            end)
        end
        table.clear(AntiSys.PConstraints)
    end

    function antiPlayersReconcile()
        local mine = antiOwnColliderParts()
        if #mine == 0 then
            antiClearPConstraints()
            return
        end
        local theirs = antiTrafficParts()
        if #theirs == 0 then
            antiClearPConstraints()
            return
        end
        local desired = {}
        for _, myPart in ipairs(mine) do
            if myPart.Parent then
                local map = desired[myPart]
                if not map then
                    map = {}
                    desired[myPart] = map
                end
                for _, tp in ipairs(theirs) do
                    if tp.Parent then map[tp] = true end
                end
            end
        end
        for c in pairs(AntiSys.PConstraints) do
            local p0, p1 = c.Part0, c.Part1
            local map = p0 and desired[p0]
            if not map or not map[p1] then
                AntiSys.PConstraints[c] = nil
                pcall(function()
                    if c.Parent then c:Destroy() end
                end)
            else
                map[p1] = nil
            end
        end
        for myPart, map in pairs(desired) do
            for tp in pairs(map) do
                pcall(function()
                    local con = Instance.new("NoCollisionConstraint")
                    con.Name = "__LuaHubPlayerPass"
                    con.Part0 = myPart
                    con.Part1 = tp
                    con.Parent = myPart
                    AntiSys.PConstraints[con] = true
                end)
            end
        end
    end

    -- Anti Arrest: блинк-телепорт от шокера. При ударе тазера (ragdoll) —
    -- мгновенный прыжок на 18м от угрозы + встать. Превентивно: враг с шокером
    -- в руках рядом — блинк вбок (не чаще раза в 3 сек).
    function antiHasTaser(ch)
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") then
                local n = string.lower(t.Name)
                if n:find("taser", 1, true) or n:find("tazer", 1, true)
                    or n:find("stun", 1, true) or n:find("shock", 1, true)
                    or n:find("cuff", 1, true) or n:find("arrest", 1, true) then
                    return true
                end
            end
        end
        return false
    end

    function antiThreatDir()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return Vector3.new(1, 0, 0) end
        local best, bestD = nil, nil
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Parent then
                local ch = plr.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - root.Position).Magnitude
                    if not bestD or d < bestD then bestD, best = d, hrp.Position end
                end
            end
        end
        if best and bestD < 60 then
            local away = root.Position - best
            away = Vector3.new(away.X, 0, away.Z)
            if away.Magnitude > 0.5 then return away.Unit end
        end
        local cam = workspace.CurrentCamera
        if cam then
            local r = cam.CFrame.RightVector
            r = Vector3.new(r.X, 0, r.Z)
            if r.Magnitude > 0.1 then
                AntiSys.BlinkSide = not AntiSys.BlinkSide
                return (AntiSys.BlinkSide and r.Unit or -r.Unit)
            end
        end
        return Vector3.new(1, 0, 0)
    end

    function antiBlink(dist)
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local dir = antiThreatDir()
        -- разброс ±35°, чтобы не читать направление
        local ang = math.rad(math.random(-35, 35))
        local c, s = math.cos(ang), math.sin(ang)
        dir = Vector3.new(dir.X * c - dir.Z * s, 0, dir.X * s + dir.Z * c)
        if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) end
        pcall(function()
            root.CFrame = root.CFrame + dir.Unit * dist
        end)
    end

    -- Anti Arrest: блинк от шокера + выпрыгнуть из чужой машины + встать.
    function antiArrestTick()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local now = os.clock()
        local seat = hum.SeatPart
        if seat then
            local car = seat:FindFirstAncestorOfClass("Model")
            if car then
                local foreign = false
                for _, d in ipairs(car:GetDescendants()) do
                    if d:IsA("Humanoid") and d ~= hum and d.Health > 0 then
                        local plr = Players:GetPlayerFromCharacter(d.Parent)
                        if plr and plr ~= LocalPlayer then foreign = true break end
                    end
                end
                if foreign then
                    pcall(function()
                        hum.Sit = false
                        hum.Jump = true
                    end)
                    antiBlink(20)
                    AntiSys.LastBlink = now
                    return
                end
            end
            AntiSys.WasRagdoll = false
            return
        end
        if hum.PlatformStand then
            if not AntiSys.WasRagdoll then
                AntiSys.WasRagdoll = true
                antiBlink(22)
                AntiSys.LastBlink = now
            end
            pcall(function()
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
            return
        end
        AntiSys.WasRagdoll = false
        if now - AntiSys.LastBlink >= 2 then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Parent then
                        local ch = plr.Character
                        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                        if hrp and (hrp.Position - root.Position).Magnitude <= 25
                            and antiHasTaser(ch) then
                            antiBlink(15)
                            AntiSys.LastBlink = now
                            break
                        end
                    end
                end
            end
        end
    end

    -- Живой статус Anti: цифры вместо гаданий. Обновляется раз в секунду.
    function antiStatusText()
        local bp = 0
        for _ in pairs(AntiSys.BarrierList) do bp = bp + 1 end
        local fp = 0
        for _ in pairs(AntiSys.FenceList) do fp = fp + 1 end
        local cn, pn = 0, 0
