    function npcNameOk(model, hum)
        local blob = string.lower(model.Name)
        if hum then
            local ok, dn = pcall(function() return hum.DisplayName end)
            if ok and type(dn) == "string" and dn ~= "" then
                blob = blob .. " " .. string.lower(dn)
            end
        end
        for _, kw in ipairs(NpcSys.Keywords) do
            if string.find(blob, kw, 1, true) then return true end
        end
        return false
    end

    function npcValidModel(model)
        if not model or not model.Parent then return false end
        if not model:IsA("Model") then return false end
        if Players:GetPlayerFromCharacter(model) then return false end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        if not root then return false end
        if not model:FindFirstChild("Head") then return false end
        return true
    end

    function npcConsider(model)
        if NpcSys.Cache[model] then return end
        local count = 0
        for _ in pairs(NpcSys.Cache) do count = count + 1 end
        if count >= NpcSys.MaxModels then return end
        if not npcValidModel(model) then return end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not npcNameOk(model, hum) then return end
        npcEnsure(model, hum)
    end

    function npcEnsure(model, hum)
        if NpcSys.Cache[model] then return NpcSys.Cache[model] end
        hum = hum or model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        local head = model:FindFirstChild("Head")
        if not hum or not root or not head then return nil end
        local d = { hum = hum, root = root, head = head, hl = nil, gui = nil, nameL = nil, distL = nil }
        local okHl, hl = pcall(createHighlight, model, NpcSys.Color, 0.5, 0)
        if okHl and hl then d.hl = hl end
        local okGui, gui, nameL, distL = pcall(function()
            local g = Instance.new("BillboardGui")
            g.Name = "LuaHubNpcTag"
            g.Size = UDim2.new(0, 140, 0, 36)
            g.StudsOffset = Vector3.new(0, 2.8, 0)
            g.AlwaysOnTop = true
            g.Enabled = false
            local n = Instance.new("TextLabel")
            n.Name = "Name"
            n.Size = UDim2.new(1, 0, 0, 18)
            n.BackgroundTransparency = 1
            n.Font = Enum.Font.Code
            n.TextSize = 13
            n.TextColor3 = Color3.fromRGB(255, 200, 100)
            n.TextStrokeTransparency = 0.2
            n.Parent = g
            local s = Instance.new("TextLabel")
            s.Name = "Dist"
            s.Size = UDim2.new(1, 0, 0, 14)
            s.Position = UDim2.new(0, 0, 0, 20)
            s.BackgroundTransparency = 1
            s.Font = Enum.Font.Code
            s.TextSize = 11
            s.TextColor3 = Color3.fromRGB(255, 255, 255)
            s.TextStrokeTransparency = 0.2
            s.Parent = g
            g.Adornee = head
            g.Parent = model
            return g, n, s
        end)
        if okGui and gui then d.gui, d.nameL, d.distL = gui, nameL, distL end
        NpcSys.Cache[model] = d
        return d
    end

    function npcHideEntry(d)
        if not d then return end
        if d.hl then pcall(hlDisable, d.hl) end
        if d.gui then pcall(function() d.gui.Enabled = false end) end
    end

    function npcRemove(model)
        local d = NpcSys.Cache[model]
        if d then
            if d.hl then pcall(instDestroy, d.hl) end
            if d.gui then pcall(instDestroy, d.gui) end
            NpcSys.Cache[model] = nil
        end
    end

    function npcClear()
        for model in pairs(NpcSys.Cache) do npcRemove(model) end
    end

    function npcScanAsync()
        if NpcSys.ScanRunning then return end
        if os.clock() < NpcSys.NextScan then return end
        NpcSys.ScanRunning = true
        NpcSys.NextScan = os.clock() + NpcSys.ScanInterval
        task.spawn(function()
            local ok, descendants = pcall(function() return workspace:GetDescendants() end)
            if ok and descendants then
                local n = #descendants
                local i = 1
                while i <= n and not hubDestroyed do
                    local t0 = os.clock()
                    while i <= n do
                        local v = descendants[i]
                        i = i + 1
                        if v:IsA("Model") then pcall(npcConsider, v) end
                        if os.clock() - t0 >= 0.003 then break end
                    end
                    task.wait()
                end
            end
            if not hubDestroyed then
                for model in pairs(NpcSys.Cache) do
                    local d = NpcSys.Cache[model]
                    local alive = model.Parent and d.hum and d.hum.Parent and d.hum.Health > 0
                    if not alive then npcRemove(model) end
                end
            end
            NpcSys.ScanRunning = false
        end)
    end

    function npcReconDump()
        print("")
        print("╔══════════════ NPC RECON DUMP ══════════════╗")
        local shown = 0
        local ok, descendants = pcall(function() return workspace:GetDescendants() end)
        if ok and descendants then
            for _, v in ipairs(descendants) do
