    -- FIX Wanted: авто-поиск имён полей звёзд. Сканирует всех игроков,
    -- ищет ValueBase/атрибуты со значениями 1-5 и тексты со звёздами,
    -- неизвестные имена складывает в WANTED_CUSTOM_KEYS и сбрасывает кэш.
    function wantedAutoLearn()
        local found = {}
        local function considerName(name)
            local ln = tostring(name):lower()
            if ln == "" then return end
            for _, k in ipairs(WANTED_KEYS) do
                if ln:find(k, 1, true) then return end
            end
            for _, k in ipairs(WANTED_CUSTOM_KEYS) do
                if ln == k then return end
            end
            for _, k in ipairs(found) do
                if k == ln then return end
            end
            table.insert(found, ln)
        end
        for _, player in ipairs(Players:GetPlayers()) do
            for k, v in pairs(player:GetAttributes()) do
                local n = tonumber(v)
                if n and n >= 1 and n <= 5 then considerName(k) end
            end
            local ls = player:FindFirstChild("leaderstats")
            if ls then
                for _, s in ipairs(ls:GetChildren()) do
                    if s:IsA("ValueBase") then
                        local n = tonumber(s.Value)
                        if n and n >= 1 and n <= 5 then considerName(s.Name) end
                        local sv = tostring(s.Value):lower()
                        if sv:find("★", 1, true) or sv:find("*", 1, true) then
                            considerName(s.Name)
                        end
                    end
                end
            end
            for _, o in ipairs(player:GetChildren()) do
                if o:IsA("ValueBase") then
                    local n = tonumber(o.Value)
                    if n and n >= 1 and n <= 5 then considerName(o.Name) end
                end
            end
            local char = player.Character
            if char then
                for k, v in pairs(char:GetAttributes()) do
                    local n = tonumber(v)
                    if n and n >= 1 and n <= 5 then considerName(k) end
                end
            end
        end
        for _, k in ipairs(found) do table.insert(WANTED_CUSTOM_KEYS, k) end
        if #found > 0 then wantedCache = {} end
        return found
    end

