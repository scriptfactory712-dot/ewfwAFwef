local function cpFindStampTool(char)
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, container in ipairs({char, backpack}) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    local text = (item.Name .. " " .. item.ToolTip):lower()
                    if text:find("stamp", 1, true) or text:find("approve", 1, true)
                        or text:find("печать", 1, true) then
                        return item
                    end
                end
            end
        end
    end
    return nil
end
local function cpEnsureStamp(char, hum)
    local stamp = cpFindStampTool(char)
    if not stamp then
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        for _, container in ipairs({ backpack, char }) do
            if container then
                for _, item in ipairs(container:GetChildren()) do
                    if item:IsA("Tool") then stamp = item break end
                end
            end
            if stamp then break end
        end
    end
    if stamp and stamp.Parent ~= char then
        pcall(function() hum:EquipTool(stamp) end)
    end
    return stamp
end
-- Снапшот числовых leaderstats + проверка прироста (успех гранта: +20 XP).
-- Нужно для AFK-водителей: R сработал, а машина не уехала — успех виден по XP.
-- Чистые, на уровне чанка (лимит 200 регистров в хабе).
local function cpSnapStats()
    local t = {}
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        for _, s in ipairs(ls:GetChildren()) do
            if s:IsA("IntValue") or s:IsA("NumberValue") or s:IsA("StringValue") then
                local n = tonumber(s.Value)
                if n then t["ls_" .. s.Name] = n end
            end
        end
    end
    for k, v in pairs(LocalPlayer:GetAttributes()) do
        local n = tonumber(v)
        if n then t["attr_" .. k] = n end
    end
    local char = LocalPlayer.Character
    if char then
        for k, v in pairs(char:GetAttributes()) do
            local n = tonumber(v)
            if n then t["char_" .. k] = n end
        end
    end
    return t
end
local function cpStatsGain(before, minGain)
    if not before then return false end
    local gain = minGain or 5
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        for _, s in ipairs(ls:GetChildren()) do
            if (s:IsA("IntValue") or s:IsA("NumberValue") or s:IsA("StringValue")) and before["ls_" .. s.Name] ~= nil then
                local now = tonumber(s.Value) or 0
                if now - before["ls_" .. s.Name] >= gain then return true end
            end
        end
    end
    for k, v in pairs(LocalPlayer:GetAttributes()) do
        local n = tonumber(v)
        if n and before["attr_" .. k] ~= nil and n - before["attr_" .. k] >= gain then return true end
    end
    local char = LocalPlayer.Character
    if char then
        for k, v in pairs(char:GetAttributes()) do
            local n = tonumber(v)
            if n and before["char_" .. k] ~= nil and n - before["char_" .. k] >= gain then return true end
        end
    end
    return false
end
local function cpIsCheckpointPlayer(player)
    local team = player and player.Team and player.Team.Name:lower() or ""
    return team:find("checkpoint", 1, true) ~= nil or team:find("border", 1, true) ~= nil
end
local function cpOtherGuardNearSeat(seat, maxDistance)
    if not seat then return false end
    local limit = maxDistance or 14
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and cpIsCheckpointPlayer(player) then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root and hum and hum.Health > 0 and (root.Position - seat.Position).Magnitude <= limit then
                return true
            end
        end
    end
    return false
end
