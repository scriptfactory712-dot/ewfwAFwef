    -- Полное выключение хаба (одна функция на обе кнопки Destroy).
    function hubDestroyAll()
        hubDestroyed = true
        stopESP()
        pcall(aimStop)
        pcall(npcClear)
        pcall(antiDisable)
        pcall(antiRecoilRestore)
        pcall(visualRestoreLight)
        pcall(function() visualAtmoOff(true) end)
        pcall(visualMusicStop)
        pcall(function()
            if ShipSys.Line then ShipSys.Line:Remove() end
            if ShipSys.Text then ShipSys.Text:Remove() end
        end)
        ShipSys.Line, ShipSys.Text = nil, nil
        afEnabled = false
        afRunId = afRunId + 1
        afDisableNoclip()
        afStopMovement()
        for player in pairs(playerConnections) do cleanupPlayer(player) end
        for player in pairs(wantedEspCache) do cleanupWantedPlayer(player) end
        clearAllVehicles()
        if shipHighlight then pcall(instDestroy, shipHighlight) end
        shipHighlight = nil; shipModel = nil; clearContainers()
        -- FIX 8: destroy all leftover Highlight instances (was leaking)
        for _, c in pairs(espCache) do
            if c.highlight then pcall(instDestroy, c.highlight); c.highlight = nil end
        end
        for _, c in pairs(wantedEspCache) do
            if c.highlight then pcall(instDestroy, c.highlight); c.highlight = nil end
        end
        for _, hl in pairs(containerCache) do pcall(instDestroy, hl) end
        containerCache = {}
        if playerRemovingConn then playerRemovingConn:Disconnect() end
        if playerAddedConn then playerAddedConn:Disconnect() end
        for _, conn in ipairs(workspaceConnections) do conn:Disconnect() end
        pcall(function() Window:Destroy() end)
    end

    -- Выключить ВСЕ функции, окно остаётся открытым.
    function disableAllFeatures()
        espEnabled = false
        wantedEspEnabled = false
        vehEnabled = false
        shipEnabled = false
        containerEnabled = false
        AimSys.Cfg.Enabled = false
        AimSys.Shoot.Enabled = false
        AimSys.State.Aim = false
        aimClearState(true)
        AimSys.Cached = nil
        if AimSys.FovFrame then pcall(function() AimSys.FovFrame.Visible = false end) end
        afEnabled = false
        afRunId = afRunId + 1
        afDisableNoclip()
        afStopMovement()
        AntiSys.Enabled = false
        AntiSys.Fence = false
        AntiSys.Speed = false
        AntiSys.AFK = false
        AntiSys.Players = false
        AntiSys.Cuffs = false
        AntiSys.Arrest = false
        AntiSys.Recoil = false
        VisualSys.Fullbright = false
        for name in pairs(AntiSys.Cats) do
            AntiSys.Cats[name].On = false
            antiCatRestore(name)
        end
        stopESP()
        -- БЕЗ aimStop: он рвёт коннекты и аим уже не включится обратно.
        pcall(npcClear)
        pcall(antiDisable)
        pcall(antiRecoilRestore)
        pcall(visualRestoreLight)
        pcall(function() visualAtmoOff(true) end)
        pcall(visualMusicStop)
        for _, c in pairs(espCache) do hideCache(c) end
        for _, c in pairs(wantedEspCache) do hideWantedCache(c) end
        for _, d in pairs(NpcSys.Cache) do npcHideEntry(d) end
        hideAllVehicles()
        if AimSys.ToggleRef then pcall(function() AimSys.ToggleRef:SetValue(false) end) end
        if NpcSys.ToggleRef then pcall(function() NpcSys.ToggleRef:SetValue(false) end) end
        refreshRender()
        Notify("Settings", "All features OFF", 3)
    end

