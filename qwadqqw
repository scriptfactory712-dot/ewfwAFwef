    -- Anti Handcuffs: наручники рядом/на тебе — блинк + сорвать.
    function antiHasCuffs(ch)
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") or t:IsA("Accessory") then
                local n = string.lower(t.Name)
                if n:find("cuff", 1, true) or n:find("handcuff", 1, true)
                    or n:find("zip", 1, true) or n:find("shackle", 1, true)
                    or n:find("restrain", 1, true) then
                    return true
                end
            end
        end
        return false
    end

    function antiCuffFlagOn(obj)
        for k, v in pairs(obj:GetAttributes()) do
            local lk = string.lower(k)
            if v == true and (lk:find("cuff", 1, true) or lk:find("arrest", 1, true)
                or lk:find("restrain", 1, true) or lk:find("jailed", 1, true)) then
                return true
            end
        end
        return false
    end

    function antiCuffTick()
        local char = LocalPlayer.Character
        if not char then return end
        local now = os.clock()
        -- наручники уже на мне: сорвать + блинк
        local torn = false
        for _, o in ipairs(char:GetDescendants()) do
            if o:IsA("Tool") or o:IsA("Accessory") then
                local n = string.lower(o.Name)
                if n:find("cuff", 1, true) or n:find("shackle", 1, true)
                    or n:find("restrain", 1, true) then
                    pcall(function() o:Destroy() end)
                    torn = true
                end
            end
        end
        if torn or antiCuffFlagOn(char) or antiCuffFlagOn(LocalPlayer) then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum.Jump = true end) end
            antiBlink(22)
            AntiSys.LastBlink = now
            return
        end
        -- враг с наручниками рядом: блинк (не чаще 2с)
        if now - AntiSys.LastBlink >= 2 then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Parent then
                        local ch = plr.Character
                        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                        if hrp and (hrp.Position - root.Position).Magnitude <= 25
                            and antiHasCuffs(ch) then
                            antiBlink(15)
                            AntiSys.LastBlink = now
                            break
                        end
                    end
                end
            end
        end
    end

    -- No Recoil (рабочий метод из mainV2): нулим First/ThirdPersonCameraRecoilFactor
    -- у всех пушек (GunConfig.Stats) + глушим ImpulsePitch и пружину отдачи
    -- у CameraController. Дожимается тиком, оригиналы возвращаются при выкл.
    function antiRecoilApply()
        local rss = nil
        pcall(function() rss = game:GetService("ReplicatedStorage") end)
        local gunMod = rss and rss:FindFirstChild("SharedModules")
        gunMod = gunMod and gunMod:FindFirstChild("Configs")
        gunMod = gunMod and gunMod:FindFirstChild("GunConfig")
        local camMod = rss and rss:FindFirstChild("ClientModules")
        camMod = camMod and camMod:FindFirstChild("CameraController")
        if not gunMod or not camMod then return false end
        local okG, gunConfig = pcall(require, gunMod)
        local okC, camCtl = pcall(require, camMod)
        if not okG or type(gunConfig) ~= "table" then return false end
        if not okC or type(camCtl) ~= "table" then return false end
        AntiSys.RecoilGun = gunConfig
        for _, config in pairs(gunConfig) do
            local stats = type(config) == "table" and config.Stats
            if type(stats) == "table" then
                if AntiSys.RecoilSaved[stats] == nil then
                    AntiSys.RecoilSaved[stats] = {
                        fp = stats.FirstPersonCameraRecoilFactor,
                        tp = stats.ThirdPersonCameraRecoilFactor,
                    }
                end
                pcall(function()
                    stats.FirstPersonCameraRecoilFactor = 0
                    stats.ThirdPersonCameraRecoilFactor = 0
                end)
            end
        end
        if not AntiSys.RecoilCam then
            AntiSys.RecoilCam = camCtl
            AntiSys.RecoilOrigImpulse = camCtl.ImpulsePitch
            AntiSys.RecoilOrigSpring = camCtl.GetRecoilSpring
            local okS, spring = pcall(function() return camCtl:GetRecoilSpring() end)
            if okS and spring then
                AntiSys.RecoilReal = spring
                local silent = setmetatable({ Impulse = function() return nil end }, {
                    __index = spring,
                    __newindex = function(_, k, v) spring[k] = v end,
                })
                pcall(function()
                    camCtl.ImpulsePitch = function() return nil end
                    camCtl.GetRecoilSpring = function() return silent end
                end)
                AntiSys.RecoilImpFn = camCtl.ImpulsePitch
                AntiSys.RecoilSpringFn = camCtl.GetRecoilSpring
            end
        end
        antiRecoilClearSpring()
        return true
    end

    function antiRecoilClearSpring()
        local spring = AntiSys.RecoilReal
        if spring then
            pcall(function()
                spring.Position = 0
                spring.Velocity = 0
                spring.Target = 0
            end)
        end
    end

    function antiRecoilTick()
        if not AntiSys.RecoilGun and not antiRecoilApply() then return end
        for stats in pairs(AntiSys.RecoilSaved) do
            pcall(function()
                stats.FirstPersonCameraRecoilFactor = 0
                stats.ThirdPersonCameraRecoilFactor = 0
            end)
        end
        antiRecoilClearSpring()
    end

    function antiRecoilRestore()
        local cam = AntiSys.RecoilCam
        if cam then
            pcall(function()
                if cam.ImpulsePitch == AntiSys.RecoilImpFn then
                    cam.ImpulsePitch = AntiSys.RecoilOrigImpulse
                end
                if cam.GetRecoilSpring == AntiSys.RecoilSpringFn then
                    cam.GetRecoilSpring = AntiSys.RecoilOrigSpring
                end
            end)
        end
        for stats, saved in pairs(AntiSys.RecoilSaved) do
            pcall(function()
                stats.FirstPersonCameraRecoilFactor = saved.fp
                stats.ThirdPersonCameraRecoilFactor = saved.tp
            end)
        end
        table.clear(AntiSys.RecoilSaved)
        antiRecoilClearSpring()
        AntiSys.RecoilGun, AntiSys.RecoilCam = nil, nil
        AntiSys.RecoilOrigImpulse, AntiSys.RecoilOrigSpring = nil, nil
        AntiSys.RecoilImpFn, AntiSys.RecoilSpringFn, AntiSys.RecoilReal = nil, nil, nil
    end

    -- Anti Drown: не задыхаться под водой + инф-ХП. Ищем кислородные значения
    -- (атрибуты/Value) и доливаем, плюс держим Health = MaxHealth.
    function antiDrownScan()
        table.clear(AntiSys.DrownCands)
        local scopes = { LocalPlayer, LocalPlayer.Character }
        for _, scope in ipairs(scopes) do
            if scope then
                for k, v in pairs(scope:GetAttributes()) do
                    local lk = string.lower(k)
                    if type(v) == "number" and (lk:find("oxy", 1, true) or lk:find("breath", 1, true)
                        or lk:find("drown", 1, true) or lk:find("underwater", 1, true)
                        or lk:find("lung", 1, true) or lk:find("air", 1, true)) then
                        table.insert(AntiSys.DrownCands, { kind = "attr", obj = scope, key = k, max = v })
                    end
                end
                for _, d in ipairs(scope:GetDescendants()) do
                    if d:IsA("NumberValue") or d:IsA("IntValue") then
                        local ln = string.lower(d.Name)
                        if ln:find("oxy", 1, true) or ln:find("breath", 1, true)
                            or ln:find("drown", 1, true) or ln:find("underwater", 1, true)
                            or ln:find("air", 1, true) then
                            table.insert(AntiSys.DrownCands, { kind = "val", obj = d, max = d.Value })
                        end
                    end
                end
            end
        end
        return #AntiSys.DrownCands
    end

    function antiDrownTick()
        for _, c in ipairs(AntiSys.DrownCands) do
            if c.kind == "attr" then
                local ok, v = pcall(function() return c.obj:GetAttribute(c.key) end)
                if ok and type(v) == "number" and v < c.max then
                    pcall(function() c.obj:SetAttribute(c.key, c.max) end)
                end
            elseif c.obj and c.obj.Parent then
                if c.obj.Value < c.max then
                    pcall(function() c.obj.Value = c.max end)
                end
            end
        end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 and hum.Health < hum.MaxHealth then
            pcall(function() hum.Health = hum.MaxHealth end)
        end
    end

