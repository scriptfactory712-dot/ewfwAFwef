    -- AI DIRECTOR: что «видит» система (показываем в терминале)
    local cpSeeLine = "SEE: ..."
    local cpSeeGui = false -- виден ли текст пропуска в GUI
    local cpVisionAnchors = {} -- якоря R-промптов у линий из последнего скана
    local cpVisionNear = nil   -- ближайший R-промпт к игроку из скана
    local afOriginalWalkSpeed = nil

    function afRenderTerminal()
        local uptime = afEnabled and math.floor(os.clock() - afStartedAt) or 0
        local body = string.format(
            "[MODE] CHECKPOINT AUTHORITY\n[STATE] %s\n%s\n[PROCESSED] %d\n[UPTIME] %ds\n[ERROR] %s\n\n%s",
            afState, cpSeeLine, cpProcessed, uptime, afLastError,
            table.concat(afLogs, "\n")
        )
        if afTerminalRef then
            pcall(function()
                if afTerminalRef.SetDesc then afTerminalRef:SetDesc(body)
                elseif afTerminalRef.SetContent then afTerminalRef:SetContent(body) end
            end)
        end
    end

    function afLog(level, message)
        local line = string.format("[%s] [%s] %s", os.date("%H:%M:%S"), level, tostring(message))
        table.insert(afLogs, line)
        while #afLogs > 6 do table.remove(afLogs, 1) end
        if level == "ERROR" then afLastError = tostring(message) end
        afRenderTerminal()
    end



    function afStopMovement()
        afMoveDirection = Vector3.zero
        pcall(function() RunService:UnbindFromRenderStep(afMoveBindingName) end)
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum:Move(Vector3.zero, false)
                if afOriginalWalkSpeed then hum.WalkSpeed = afOriginalWalkSpeed end
            end)
        end
        afOriginalWalkSpeed = nil
    end

    function afStartMovement()
        pcall(function() RunService:UnbindFromRenderStep(afMoveBindingName) end)
        RunService:BindToRenderStep(afMoveBindingName, Enum.RenderPriority.Last.Value, function()
            pcall(function()
            if not afEnabled then return end
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                -- Если сидим в машине/стуле — выпрыгиваем, иначе Move не работает
                if hum.SeatPart then
                    pcall(function() hum.Jump = true end)
                    return
                end
                if not afOriginalWalkSpeed then afOriginalWalkSpeed = hum.WalkSpeed end
                if hum.WalkSpeed < afRunSpeed then hum.WalkSpeed = afRunSpeed end
                -- Двигаем направлением; поворот отдаём гуманоиду (AutoRotate),
                -- иначе CFrame.lookAt каждый кадр дерётся с физикой и мотает взад-вперёд
                if afMoveDirection.Magnitude > 0.05 then
                    hum:Move(afMoveDirection, false)
                else
                    pcall(function() hum:Move(Vector3.zero, false) end)
                end
            end
            end)
        end)
    end

    function afEnableNoclip()
        if afNoclipConn then return end
        if not afNoclipEnabled then return end
        afNoclipConn = RunService.Stepped:Connect(function()
            pcall(function()
                if not afEnabled or not afNoclipEnabled then return end
                local char = LocalPlayer.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end)
    end

    function afDisableNoclip()
        if afNoclipConn then
            pcall(function() afNoclipConn:Disconnect() end)
            afNoclipConn = nil
        end
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then pcall(function() root.CanCollide = false end) end
        end
    end

    function afResetGroundPath()
        afPathWaypoints = {}
        afPathIndex = 1
        afPathBuiltAt = 0
        afPathTargetPosition = nil
    end

    function afBuildGroundPath(root, targetRoot)
        local endpoint = targetRoot.Position
        local delta = endpoint - root.Position
        if delta.Magnitude > 220 then
            endpoint = root.Position + delta.Unit * 220
        end
        local groundParams = RaycastParams.new()
        groundParams.FilterType = Enum.RaycastFilterType.Exclude
        -- Parent у фейк-таргета может быть nil — в фильтр его класть нельзя
        local ignoreList = {LocalPlayer.Character}
        if targetRoot.Parent then table.insert(ignoreList, targetRoot.Parent) end
        groundParams.FilterDescendantsInstances = ignoreList
        groundParams.IgnoreWater = false
        -- Снэп к земле — только для точек маршрута. Для реальных деталей
        -- (окно будки, NoSnap=true) снэп запрещён: луч упёрся бы в крышу
        -- и повёл бы персонажа наверх вместо окна.
        if not targetRoot.NoSnap then
            local ground = workspace:Raycast(
                endpoint + Vector3.new(0, 100, 0),
                Vector3.new(0, -250, 0),
                groundParams
            )
            if ground then endpoint = ground.Position + Vector3.new(0, 2.5, 0) end
        end
        local path = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            AgentCanClimb = true,
            WaypointSpacing = 5,
        })
        local ok, err = pcall(function()
            path:ComputeAsync(root.Position, endpoint)
        end)
        afPathBuiltAt = os.clock()
        afPathTargetPosition = targetRoot.Position
        if not ok or path.Status ~= Enum.PathStatus.Success then
            afPathWaypoints = {}
            afPathIndex = 1
            if not ok then afLastError = "Pathfinding: " .. tostring(err) end
            return false
        end
        afPathWaypoints = path:GetWaypoints()
        -- Старт НЕ со 2-й точки, а с ближайшей: пересбор пути в движении
        -- иначе швырял назад к началу маршрута (замыкание туда-сюда).
        afPathIndex = 1
        do
            local bestI, bestD = 1, math.huge
            for i, wp in ipairs(afPathWaypoints) do
                local dd = (wp.Position - root.Position).Magnitude
                if dd < bestD then bestD, bestI = dd, i end
            end
            afPathIndex = bestI
        end
        return #afPathWaypoints > 0
    end


    -- ========== CHECKPOINT AUTHORITY AUTO PROCESS ==========
    -- cpButtonText/cpFindButton/cpClick: вынесены на уровень чанка (лимит 200 регистров)
    function cpJoinTeam()
        local currentTeam = LocalPlayer.Team and LocalPlayer.Team.Name:lower() or ""
        if currentTeam:find("checkpoint", 1, true) or currentTeam:find("border", 1, true) then
            return true
        end
        local teamButton = cpFindButton({"checkpoint authority"})
        if teamButton then
            cpClick(teamButton)
            task.wait(0.35)
            local joinButton = cpFindButton({"join"})
            if joinButton then
                cpClick(joinButton)
                afLog("TEAM", "Checkpoint Authority → Join")
                return true
            end
        end
        return false
    end



    function cpNavigateTo(root, workPart)
        local targetPos = workPart.Position
        local distance = (targetPos - root.Position).Magnitude
        afDistance = distance
        -- Пришли: стоп и сброс пути, чтобы дальше персонаж стоял/фармил.
        -- Arrive задаёт точность (для окна будки — дистанция активации промпта).
        local arriveR = workPart.Arrive or 8
        if distance <= arriveR then
            afMoveDirection = Vector3.zero
            afResetGroundPath()
            return true
        end
        local now = os.clock()
        if not cpLastPosition or (root.Position - cpLastPosition).Magnitude >= 1.5 then
            cpLastPosition = root.Position
            cpLastProgressAt = now
        elseif now - cpLastProgressAt > 2 and now - cpLastJumpAt > 2.5 then
            cpLastJumpAt = now
            cpLastProgressAt = now
            afResetGroundPath()
            if afAutoJumpEnabled then
                local hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
                if hum then hum.Jump = true end
                afState = "JUMPING OVER OBSTACLE"
            else
                afState = "STUCK (прыжок выкл)"
            end
            return false
        end
        local function setDirect(to)
            local direct = Vector3.new(to.X - root.Position.X, 0, to.Z - root.Position.Z)
            if direct.Magnitude > 0.2 then
                afMoveDirection = direct.Unit
            else
                afMoveDirection = Vector3.zero
            end
        end
        -- Ноклип ВЫКЛ: стены уважаем. Вблизи (<=14) — напрямую (финальный
        -- подход к точке/окну), дальше — только Pathfinding в обход стен.
        local directDistance = workPart.DirectDistance or 14
        local stateLabel = workPart.StateLabel
        if distance <= directDistance then
            setDirect(targetPos)
            afState = (stateLabel or "GOING DIRECTLY") .. " (" .. math.floor(distance) .. "m)"
            return false
        end
        -- Далеко: пробуем Pathfinding, если не вышло — идём напрямую
        local moved = not afPathTargetPosition
            or (targetPos - afPathTargetPosition).Magnitude > 8
        if #afPathWaypoints == 0 or os.clock() - afPathBuiltAt > 4 or moved then
            local built = afBuildGroundPath(root, workPart)
            if not built then
                setDirect(targetPos)
                afState = (stateLabel or "GOING DIRECT") .. " (NO PATH, " .. math.floor(distance) .. "m)"
                return false
            end
        end
        local waypoint = nil
        -- Пропускаем ВСЕ пройденные/позади-точки, а не одну: на скорости 36
        -- вейпоинт пролетается за тик, и разворот назад — это и было мотание.
        -- Вперёд — только к точке впереди по курсу, назад не бежим никогда.
        while afPathIndex <= #afPathWaypoints do
            local wp = afPathWaypoints[afPathIndex]
            local dx, dz = wp.Position.X - root.Position.X, wp.Position.Z - root.Position.Z
            local flatD = math.sqrt(dx * dx + dz * dz)
            if flatD > 8 then
                local tx, tz = targetPos.X - root.Position.X, targetPos.Z - root.Position.Z
                if dx * tx + dz * tz >= 0 then waypoint = wp break end
                if flatD > 30 then waypoint = wp break end
            end
            afPathIndex = afPathIndex + 1
        end
        waypoint = waypoint or afPathWaypoints[afPathIndex]
        local destination = waypoint and waypoint.Position or targetPos
        local flat = Vector3.new(destination.X - root.Position.X, 0, destination.Z - root.Position.Z)
        afMoveDirection = flat.Magnitude > 0.2 and flat.Unit or Vector3.zero
        if stateLabel then
            afState = stateLabel .. " (" .. math.floor(distance) .. "m)"
        else
            afState = (waypoint and "GOING VIA PATH (" or "GOING DIRECT (") .. math.floor(distance) .. "m)"
        end
        return false
    end

    -- cpFindOccupiedVehicle: удалён (заменён cpVisionScan — один проход вместо трёх,
    -- лимит 200 регистров). Старая 3-проходная версия давала лаги.
    -- AI DIRECTOR, глаза: ОДИН проход по workspace собирает всё сразу
    -- (машины у линий + R-промпты у линий + ближайший промпт к игроку).
    -- Токены/предикаты — на уровне чанка (лимит 200 регистров).
    -- Возвращает: bestIdx, bestSeat, anchors{[line]= {pos=Vector3, prompt=Instance}},
    -- nearestToPlayer {pos=Vector3, dist=number}, promptCount
    function cpVisionScan(root)
        local bestIdx, bestSeat, bestRootDist = nil, nil, math.huge
        local anchors = {}
        local nearPos, nearDist, nearPrompt = nil, math.huge, nil
        local promptCount = 0
        local cars = {}
        local laneSeats = {} -- ближайшее занятое сиденье у каждой полосы
        local dbgC = nil -- ближайший не-F/E промпт для дебага в терминале
        local ok, descendants = pcall(function() return workspace:GetDescendants() end)
        if not ok or not descendants then return nil, nil, anchors, nil, 0 end
        local rootPos = root.Position
        local function considerTarget(part, occ, spd)
            if not part or not part.Parent or not occ or occ.Parent == LocalPlayer.Character or cpStampedOccupants[occ] then
                return
            end
            local lineIdx, lineD = nil, math.huge
            for i, lane in ipairs(cpPostLanes) do
                for _, lp in ipairs(lane) do
                    local dx, dz = part.Position.X - lp.X, part.Position.Z - lp.Z
                    local d = math.sqrt(dx * dx + dz * dz)
                    if d < lineD then lineD, lineIdx = d, i end
                end
            end
            if not lineIdx then return end
            local rdx, rdz = part.Position.X - rootPos.X, part.Position.Z - rootPos.Z
            local rootD = math.sqrt(rdx * rdx + rdz * rdz)
            local otherUntil = cpOtherHandledUntil[occ]
            if otherUntil and otherUntil > os.clock() then
                return
            elseif otherUntil then
                cpOtherHandledUntil[occ] = nil
            end
            if cpVerifySeat ~= part and cpPostTargetIdx ~= lineIdx and cpOtherGuardNearSeat(part, 10) then
                cpOtherHandledUntil[occ] = os.clock() + 12
                return
            end
            -- lineD = старая координатная проверка; rootD = fallback по видимой машине рядом.
            local targetD = math.min(lineD, rootD)
            if lineD <= 120 or rootD <= 70 then
                local cur = laneSeats[lineIdx]
                if not cur or targetD < cur.d then
                    laneSeats[lineIdx] = {
                        seat = part,
                        occupant = occ,
                        d = targetD,
                        lineD = lineD,
                        rootD = rootD,
                        stopped = spd <= 10,
                    }
                end
            end
            if spd <= 10 and (lineD <= 40 or rootD <= 55) then
                cars[lineIdx] = true
                local postDx, postDz = cpPostLines[lineIdx].X - rootPos.X, cpPostLines[lineIdx].Z - rootPos.Z
                local postRootD = math.sqrt(postDx * postDx + postDz * postDz)
                if rootD < bestRootDist or postRootD < bestRootDist then
                    bestIdx, bestSeat, bestRootDist = lineIdx, part, math.min(rootD, postRootD)
                end
            end
        end
        for _, obj in ipairs(descendants) do
            local isSeat, isPrompt = false, false
            -- Сиденья обоих классов: в разных играх/машинах бывает Seat вместо VehicleSeat
            if obj:IsA("VehicleSeat") or obj:IsA("Seat") then isSeat = true
            elseif obj:IsA("ProximityPrompt") then isPrompt = true end
            if isSeat then
                local occ = cpGetSeatOccupant(obj)
                if occ then
                    local spd = 0
                    pcall(function() spd = obj.AssemblyLinearVelocity.Magnitude end)
                    considerTarget(obj, occ, spd)
                end
            elseif isPrompt and obj.Enabled then
                local kc = obj.KeyboardKeyCode
                if kc ~= Enum.KeyCode.F and kc ~= Enum.KeyCode.E then
                    local text = (tostring(obj.Name) .. " " .. tostring(obj.ActionText)
                        .. " " .. tostring(obj.ObjectText)):lower()
                    if not cpPromptBanned(text) then
                        local part = obj.Parent
                        while part and part ~= workspace and not part:IsA("BasePart") do part = part.Parent end
                        if part then
                            local pdx, pdz = part.Position.X - rootPos.X, part.Position.Z - rootPos.Z
                            local pd = math.sqrt(pdx * pdx + pdz * pdz)
                            -- дебаг: ближайший ЛЮБОЙ не-F/E промпт в радиусе 25м.
                            -- Сюда попадают и кастомные кнопки (KeyCode.Unknown
                            -- с отдельным текстом) — их видно в терминале.
                            if pd <= 25 and (not dbgC or pd < dbgC.d) then
                                local label = obj.ActionText
                                if label == "" then label = obj.Name end
                                dbgC = { d = pd, k = tostring(kc), t = tostring(label):sub(1, 20), m = obj.MaxActivationDistance }
                            end
                            local isR = kc == Enum.KeyCode.R or cpPromptTextOk(text)
                            if isR then
                                if pd <= 150 and pd < nearDist then
                                    nearPos, nearDist, nearPrompt = part.Position, pd, obj
                                end
                                if pd <= 60 then promptCount = promptCount + 1 end
                                -- привязка: БЛИЖАЙШИЙ промпт к середине полосы.
                                -- Было «первый попавшийся» — при полосах в 30м
                                -- друг от друга тянуло на чужую будку.
                                for i, linePos in ipairs(cpPostLines) do
                                    local ldx, ldz = part.Position.X - linePos.X, part.Position.Z - linePos.Z
                                    local ldist = math.sqrt(ldx * ldx + ldz * ldz)
                                    if ldist <= 35 then
                                        local cur = anchors[i]
                                        if not cur or ldist < (cur.d or 99999) then
                                            anchors[i] = { pos = part.Position, prompt = obj, d = ldist }
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and not cpIsCheckpointPlayer(player) then
                local char = player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local seatPart = hum and hum.SeatPart or nil
                if hum and hum.Health > 0 and seatPart and seatPart.Parent then
                    local spd = 0
                    pcall(function() spd = seatPart.AssemblyLinearVelocity.Magnitude end)
                    considerTarget(seatPart, hum, spd)
                end
            end
        end
        -- SEE-строка для терминала: что видит директор
        local chunks = {}
        for i = 1, #cpPostLines do
            chunks[i] = "P" .. i .. ":" .. (cars[i] and "CAR" or "-")
        end
        local tgt = bestIdx and (" TGT=P" .. bestIdx) or ""
        -- PR = ближайший промпт: дистанция/кнопка/текст/радиус. PR:- = рядом ничего.
        local prDbg = " | PR:-"
        if dbgC then
            prDbg = string.format(" | PR:%.0fm/%s/%s/%s", dbgC.d, dbgC.k, dbgC.t, tostring(dbgC.m))
        end
        cpSeeLine = "SEE: " .. table.concat(chunks, " ") .. tgt
            .. " | R:" .. promptCount .. (cpSeeGui and " GUI:Y" or "") .. prDbg
        return bestIdx, bestSeat, anchors, (nearPos and { pos = nearPos, dist = nearDist, prompt = nearPrompt } or nil), promptCount, laneSeats
    end

    -- cpHoldKnownPrompt: удалён (упрощение: подошёл к машине → штамп → зажим R
    -- через cpTryNearbyClearPrompt; лимит 200 регистров).

    -- cpFindStampTool/cpEnsureStamp: вынесены на уровень чанка (лимит 200 регистров)
    -- R-ONLY MODE: жмём только R (Grant Entry / Clear To Pass).
    -- Никогда не жмём F (Send to Inspection) и E (Passport/Scanner).
    -- allowBlind=true: промпт/текст не найден — всё равно СРАЗУ зажимаем R
    -- после подхода в радиус (встал-подошёл-нажал), иначе вечная стоянка.
    function cpTryNearbyClearPrompt(char, hum, root, occupant, allowBlind, holdFor)
        if cpStampBusy or os.clock() - cpLastStampAt < 0.8 then return false end
        -- occupant/pending по таймеру больше НЕ считаем успехом:
        -- раньше return true через 1.2с/0.45с засчитывал машину которой
        -- реально не нажали R, из-за этого R «умирал» на следующем посту.
        if os.clock() - cpLastPromptScanAt < 0.4 then return false end
        cpLastPromptScanAt = os.clock()
        cpStampBusy = true

        -- Сначала экипируем Stamp через Humanoid API. Не жмём hotbar 5:
        -- в Roblox повторный keypress может снять тул обратно.
        cpEnsureStamp(char, hum)
        task.wait(0.35)

        local bestPrompt, bestDistance = nil, math.huge
        local anyPrompt, anyDist = nil, math.huge
        -- счётчики для диагностики: есть ли промпты вообще (vs только R в радиусе)
        local anyCount, inRangeR = 0, 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled then
                local kc = obj.KeyboardKeyCode
                -- Строго R-промпты. F и E запрещены явно.
                if kc == Enum.KeyCode.F or kc == Enum.KeyCode.E then
                    continue
                end
                local text = (tostring(obj.Name) .. " " .. tostring(obj.ActionText)
                    .. " " .. tostring(obj.ObjectText)):lower()
                if cpPromptBanned(text) then
                    continue
                end
                anyCount = anyCount + 1
                local isClear = kc == Enum.KeyCode.R or cpPromptTextOk(text)
                if isClear then
                    local part = obj.Parent
                    while part and part ~= workspace and not part:IsA("BasePart") do part = part.Parent end
                    if part then
                        local distance = (part.Position - root.Position).Magnitude
                        if distance < anyDist then anyPrompt, anyDist = obj, distance end
                        if distance <= obj.MaxActivationDistance + 2 then
                            inRangeR = inRangeR + 1
                            if distance < bestDistance then
                                bestPrompt, bestDistance = obj, distance
                            end
                        end
                    end
                end
            end
        end
        -- Кастомные интерфейсы: один проход только по PlayerGui
        -- (раньше было 3 полных скана — отсюда лаги).
        local clearVisible = false
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if playerGui then
            local okGui, desc = pcall(function() return playerGui:GetDescendants() end)
            if okGui and desc then
                for _, obj in ipairs(desc) do
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                        if obj.Visible then
                            local t = tostring(obj.Text):lower()
                            if cpPromptTextOk(t) and not cpPromptBanned(t) then
                                clearVisible = true
                                break
                            end
                        end
                    end
                end
            end
        end
        cpSeeGui = clearVisible

        if not bestPrompt and not clearVisible then
            -- Промпт/текст не найден — всё равно ЗАЖИМАЕМ R сразу, без ожиданий:
            -- встал у будки = жмёшь. (огонь по любому R-промпту рядом + R 3 сек)
            if allowBlind then
                local visionClose = false
                local knownPrompt = anyPrompt ~= nil
                if cpVisionNear and cpVisionNear.prompt and cpVisionNear.prompt.Parent and cpVisionNear.pos then
                    knownPrompt = true
                    local maxAct = 10
                    pcall(function() maxAct = cpVisionNear.prompt.MaxActivationDistance end)
                    visionClose = (cpVisionNear.pos - root.Position).Magnitude <= maxAct + 2
                end
                -- Если R-промпт есть, но мы ещё вне радиуса (как PR:13m/10),
                -- не уходим в VERIFY: сначала надо подойти ближе.
                if knownPrompt and inRangeR <= 0 and not visionClose then
                    cpStampBusy = false
                    afState = "R PROMPT OUT OF RANGE"
                    return false
                end
                cpLastStampAt = os.clock()
                afState = "BLIND R HOLD..."
                local okBlind = pcall(function()
                    if anyPrompt then
                        pcall(function()
                            if fireproximityprompt then fireproximityprompt(anyPrompt) end
                        end)
                        task.wait(0.2)
                    end
                    -- ДВОЙНОЙ зажим R (2с + пауза + 2с): ускорено, игра ловит и за 2с
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                    task.wait(2.0)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                    task.wait(0.4)
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                    task.wait(2.0)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                end)
                cpStampBusy = false
                if not okBlind then return false end
                afState = "STAMPED [R-blind]"
                afLog("STAMP", string.format("слепой R-hold (R в радиусе: %d, всего промптов: %d)", inRangeR, anyCount))
                return true
            end
            cpStampBusy = false
            return false
        end

        cpLastStampAt = os.clock()
        afState = "HOLDING R..."
        local ok, err = pcall(function()
            if bestPrompt then
                -- Доворот к промпту чтобы hold не сорвался
                pcall(function()
                    local part = bestPrompt.Parent
                    while part and part ~= workspace and not part:IsA("BasePart") do part = part.Parent end
                    if part then
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(part.Position.X, hrp.Position.Y, part.Position.Z))
                        end
                    end
                end)
                -- 1) честный hold промпта
                bestPrompt:InputHoldBegin()
                task.wait(math.max(0.6, bestPrompt.HoldDuration + 0.6))
                bestPrompt:InputHoldEnd()
                task.wait(0.2)
                -- 2) fireproximityprompt если есть (эксплойт-функция держит 100%)
                pcall(function()
                    if fireproximityprompt then fireproximityprompt(bestPrompt) end
                end)
                task.wait(0.2)
            elseif anyPrompt then
                -- текста/промпта в упор нет, но R-промпт рядом есть — жмём его
                pcall(function()
                    if fireproximityprompt then fireproximityprompt(anyPrompt) end
                end)
                task.wait(0.2)
            end
            -- 3) физическое удержание R (2.5 сек) — ускорено
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            task.wait(2.5)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
        end)
        cpStampBusy = false
        if not ok then
            afLog("ERROR", "Stamp R: " .. tostring(err))
            return false
        end
        afState = "STAMPED [R]"
        -- Холд реально выполнен (промпт/текст был) — засчитываем сразу.
        -- Раньше тут был return false + true по таймеру, что давало
        -- ложные засчитывания и «мёртвый R».
        return true
    end

    -- cpFindNearestCar: удалён (цели берутся из скана зрения laneSeats;
    -- лимит 200 регистров, мёртвый код не держим).

    function cpTryGate(root)
        if os.clock() - cpLastGateAt < 4 then return false end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled and obj.KeyboardKeyCode == Enum.KeyCode.E then
                local text = (tostring(obj.Name) .. " " .. tostring(obj.ActionText) .. " " .. tostring(obj.ObjectText)):lower()
                if text:find("gate", 1, true) and text:find("open", 1, true) then
                    local part = obj.Parent
                    while part and part ~= workspace and not part:IsA("BasePart") do part = part.Parent end
                    if part and (part.Position - root.Position).Magnitude <= obj.MaxActivationDistance + 4 then
                        local nearLane = false
                        for _, lane in ipairs(cpPostLanes) do
                            for _, lp in ipairs(lane) do
                                if (part.Position - lp).Magnitude <= 40 then nearLane = true break end
                            end
                            if nearLane then break end
                        end
                        if not nearLane then continue end
                        cpLastGateAt = os.clock()
                        pcall(function() obj:InputHoldBegin() task.wait(math.max(0.2, obj.HoldDuration + 0.1)) obj:InputHoldEnd() end)
                        pcall(function() if fireproximityprompt then fireproximityprompt(obj) end end)
                        pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game) task.wait(0.3) VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
                        afLog("GATE", "E gate -> " .. tostring(obj.Name))
                        return true
                    end
                end
            end
        end
        return false
    end

    function cpIsInspectionNeeded(seat)
        if not seat then return false end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled and obj.KeyboardKeyCode == Enum.KeyCode.F then
                local text = (tostring(obj.Name) .. " " .. tostring(obj.ActionText) .. " " .. tostring(obj.ObjectText)):lower()
                if text:find("inspect", 1, true) then
                    local part = obj.Parent
                    while part and part ~= workspace and not part:IsA("BasePart") do part = part.Parent end
                    if part and (part.Position - seat.Position).Magnitude <= 35 then
                        return true
                    end
                end
            end
        end
        return false
    end

    function cpLoop(runId)
        cpProcessed = 0
        cpStampedOccupants = {}
        cpOtherHandledUntil = {}
        cpLastPosition = nil
        cpLastProgressAt = os.clock()
        cpLastJumpAt = 0
        cpExitIndex = 1
        cpExitPointStart = os.clock()
        cpPatrolIndex = 1
        cpPostTargetIdx = nil
        cpPostScanAt = 0
        cpPostHoldStart = 0
        cpVerifySeat, cpVerifyOccupant, cpVerifyStart = nil, nil, 0
        cpVerifySeatPos = nil
        cpHoldTries = 0
        cpXpBefore = nil
        cpLaneSeats = {}
        cpVisionAnchors = {}
        cpVisionNear = nil
        cpSeeLine = "SEE: ..."
        -- 24ч стабильность: таймауты и анти-застревание
        local cpLoopCount = 0
        cpJoinAttempted = false
        afState = "CHECKPOINT STARTING"
        afLog("INFO", "режим Checkpoint Authority запущен [R ONLY]")
        afStartMovement()
        while afEnabled and runId == afRunId do
            local ok, err = pcall(function()
                cpLoopCount = cpLoopCount + 1
                -- Команду проверяем каждый тик, а не один раз (кикает с команды)
                local currentTeam = LocalPlayer.Team and LocalPlayer.Team.Name:lower() or ""
                if not (currentTeam:find("checkpoint", 1, true) or currentTeam:find("border", 1, true)) then
                    cpJoinAttempted = cpJoinTeam()
                    if not cpJoinAttempted then
                        afState = "NEED TEAM JOIN"
                        afMoveDirection = Vector3.zero
                        return
                    end
                end
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root or not hum or hum.Health <= 0 then
                    afState = "WAITING FOR RESPAWN"
                    afMoveDirection = Vector3.zero
                    afResetGroundPath()
                    return
                end

                if cpTryGate(root) then
                    afState = "OPENING GATE (E)"
                    afMoveDirection = Vector3.zero
                    task.wait(0.6)
                    return
                end

                do
                    local hasCarForGate = false
                    for _, e in pairs(cpLaneSeats) do if e and e.seat and e.seat.Parent then hasCarForGate = true break end end
                    if hasCarForGate and cpTryGate(root) then
                        afState = "OPENING GATE (E)"
                        afMoveDirection = Vector3.zero
                        task.wait(0.6)
                        return
                    end
                end

                -- Сначала строго проходим заданный маршрут выхода. Пока он
                -- не завершён, движущиеся машины не могут менять нашу цель.
                if cpExitIndex <= #cpExitRoute then
                    local exitPosition = cpExitRoute[cpExitIndex]
                    local exitTarget = { Position = exitPosition, Parent = workspace }
                    local exitDistance = (exitPosition - root.Position).Magnitude
                    -- Длинный переход 5->6 (~250м), даём 25 сек, иначе скип
                    if os.clock() - cpExitPointStart > 25 then
                        afLog("ROUTE", "точка " .. cpExitIndex .. " недостижима, скип (" .. math.floor(exitDistance) .. "m)")
                        cpExitIndex = cpExitIndex + 1
                        cpExitPointStart = os.clock()
                        afResetGroundPath()
                        return
                    end
                    if exitDistance <= 8 then
                        cpExitIndex = cpExitIndex + 1
                        cpExitPointStart = os.clock()
                        afResetGroundPath()
                        if cpExitIndex > #cpExitRoute then
                            afMoveDirection = Vector3.zero
                            afLog("ROUTE", "выход завершён (v3), ищу будку по R")
                        else
                            afMoveDirection = Vector3.zero
                            afState = "EXIT ROUTE " .. cpExitIndex .. "/" .. #cpExitRoute
                            afRenderTerminal()
                            return
                        end
                    else
                        afState = "EXIT ROUTE " .. cpExitIndex .. "/" .. #cpExitRoute .. " (" .. math.floor(exitDistance) .. "m)"
                        cpNavigateTo(root, exitTarget)
                        afRenderTerminal()
                        return
                    end
                end

                -- ========== AI DIRECTOR: 5 ПОСТОВ ==========
                -- Печать держим ВСЕГДА экипированной (без неё R-промпты не спавнятся).
                cpEnsureStamp(char, hum)
                -- Зрение раз в 0.5с: машины по полосам ({seat,d,stopped}) + промпты + SEE.
                -- Цель ниже: обслуживаем только приехавшие/стоящие машины.
                if os.clock() - cpPostScanAt >= 0.5 then
                    cpPostScanAt = os.clock()
                    local _, _, anchors, near, _, laneSeats = cpVisionScan(root)
                    cpVisionAnchors, cpVisionNear = anchors or {}, near
                    cpLaneSeats = laneSeats or {}
                    for occ, untilAt in pairs(cpOtherHandledUntil) do
                        if untilAt <= os.clock() or not occ.Parent then cpOtherHandledUntil[occ] = nil end
                    end
                end
                -- ЦЕЛЬ (перехват по прогнозу + залипание на полосе):
                -- 1) стоящая машина у полосы → сразу бежим к машине и жмём R;
                -- 2) движущиеся/уже отпущенные машины НЕ догоняем;
                -- 3) никого → патруль по точкам (ниже, без return здесь).
                local post, tgtSeat, svcMode = nil, nil, nil
                do
                    local bestD = math.huge
                    for i = 1, #cpPostLines do
                        local e = (cpLaneSeats or {})[i]
                        local s = e and e.seat or nil
                        local occ = e and (e.occupant or cpGetSeatOccupant(s)) or nil
                        if s and s.Parent and occ and not cpStampedOccupants[occ] then
                            if e.stopped and e.d and e.d <= 40 then
                                local d = (s.Position - root.Position).Magnitude
                                if d < bestD then bestD, post, tgtSeat, svcMode = d, i, s, "service" end
                            end
                        end
                    end
                    -- Не выбираем движущиеся цели: если другая пограничка уже
                    -- пропустила машину, она уедет, а мы не побежим за ней.
                end
                -- залипание: держим свою полосу пока её машина валидна
                -- (своя полоса важнее чужой — без мотания между целями)
                do
                    local keep = cpPostTargetIdx
                    local e = keep and (cpLaneSeats or {})[keep] or nil
                    local s = e and e.seat or nil
                    local occ = e and (e.occupant or cpGetSeatOccupant(s)) or nil
                    if s and s.Parent and occ and not cpStampedOccupants[occ] then
                        if e.stopped and e.d and e.d <= 40 then
                            post, tgtSeat, svcMode = keep, s, "service"
                        end
                    end
                end
                if post then
                    if cpPostTargetIdx and cpPostTargetIdx ~= post then
                        cpHoldTries = 0
                        cpVerifySeat, cpVerifyOccupant, cpVerifyStart, cpVerifySeatPos = nil, nil, 0, nil
                        cpXpBefore = nil
                        cpPostHoldStart = 0
                    end
                    cpPostTargetIdx = post
                else
                    if cpPostTargetIdx then
                        cpHoldTries = 0
                        cpVerifySeat, cpVerifyOccupant, cpVerifyStart, cpVerifySeatPos = nil, nil, 0, nil
                        cpXpBefore = nil
                        cpPostHoldStart = 0
                    end
                    cpPostTargetIdx = nil
                end
                local tgtIdx = post
                local linePos = post and cpPostLines[post] or nil
                local promptAnchor = post and (cpVisionAnchors or {})[post] or nil
                if not promptAnchor and cpVisionNear and cpVisionNear.pos and linePos then
                    if math.sqrt((cpVisionNear.pos.X - linePos.X) ^ 2 + (cpVisionNear.pos.Z - linePos.Z) ^ 2) <= 45 then
                        promptAnchor = cpVisionNear
                    end
                end
                if tgtSeat and svcMode == "service" then
                    local targetEntry = post and (cpLaneSeats or {})[post] or nil
                    local occ = targetEntry and (targetEntry.occupant or cpGetSeatOccupant(tgtSeat)) or cpGetSeatOccupant(tgtSeat)
                    local approachPos = tgtSeat.Position or (promptAnchor and promptAnchor.pos) or linePos
                    local approachArrive = 5
                    local approachNoSnap = false
                    if promptAnchor and promptAnchor.prompt then
                        local maxAct = 10
                        pcall(function() maxAct = promptAnchor.prompt.MaxActivationDistance end)
                        approachArrive = math.max(3, math.min(5, maxAct - 2))
                        approachNoSnap = true
                    end
                    local ld = (approachPos - root.Position).Magnitude
                    if cpPostHoldStart == 0 then cpPostHoldStart = os.clock() end
                    -- страховой таймаут (путь в обход + 3 ретрая холда)
                        if cpPostHoldStart > 0 and os.clock() - cpPostHoldStart > 60 then
                            afLog("SKIP", "Машина недостижима/висит 60с — скип")
                            if occ then cpStampedOccupants[occ] = true end
                            cpHoldTries = 0
                            cpPostTargetIdx = nil
                            cpPostHoldStart = 0
                            cpVerifySeat, cpVerifyOccupant, cpVerifyStart, cpVerifySeatPos = nil, nil, 0, nil
                            cpXpBefore = nil
                            afResetGroundPath()
                            afRenderTerminal()
                            return
                        end
                        -- 0) VERIFY: R уже дожат — машина реально уехала?
                        -- Успех ТОЛЬКО по факту отъезда от точки холда, а не нажатия.
                        if cpVerifySeat ~= nil and tgtSeat == cpVerifySeat then
                            local occNow = (tgtSeat.Parent and cpGetSeatOccupant(tgtSeat)) or nil
                            local movedFar = false
                            if cpVerifySeatPos and tgtSeat.Parent then
                                movedFar = (tgtSeat.Position - cpVerifySeatPos).Magnitude > 40
                            end
                            -- УСПЕХ: водитель сменился/вышел, машина уехала
                            -- ИЛИ прыгнул XP (+20 за грант — видно даже если AFK-водитель стоит)
                            if occNow ~= cpVerifyOccupant or movedFar or cpStatsGain(cpXpBefore, 5) then
                                -- УСПЕХ: пропущена (водитель сменился/вышел) или уехала
                                cpProcessed = cpProcessed + 1
                                if cpVerifyOccupant ~= nil then cpStampedOccupants[cpVerifyOccupant] = true end
                                cpPostTargetIdx = nil
                                cpPostHoldStart = 0
                                cpVerifySeat, cpVerifyOccupant, cpVerifyStart, cpVerifySeatPos = nil, nil, 0, nil
                                cpXpBefore = nil
                                if cpProcessed % 50 == 0 then
                                    for stamped in pairs(cpStampedOccupants) do
                                        if not stamped.Parent then cpStampedOccupants[stamped] = nil end
                                    end
                                    afResetGroundPath()
                                    afLog("INFO", "чистка кэша, всего: " .. cpProcessed)
                                end
                                afLog("STAMP", "Машина пропущена [R]; всего: " .. cpProcessed)
                                cpHoldTries = 0
                                afDistance = cpProcessed
                                afRenderTerminal()
                                return
                            elseif os.clock() - cpVerifyStart > 4.5 then
                                if cpHoldTries < 3 then
                                    -- стоит спустя 8с — холд не сработал, ретрай ниже в HOLD
                                    afLog("RETRY", "Машина стоит, жму R снова (" .. (cpHoldTries + 1) .. "/3)")
                                    cpVerifySeat, cpVerifyOccupant, cpVerifyStart, cpVerifySeatPos = nil, nil, 0, nil
                                    cpXpBefore = nil
                                else
                                    afLog("SKIP", "3 холда без толку — скип")
                                    if occ then cpStampedOccupants[occ] = true end
                                    cpHoldTries = 0
                                    cpPostTargetIdx = nil
                                    cpPostHoldStart = 0
                                    cpVerifySeat, cpVerifyOccupant, cpVerifyStart, cpVerifySeatPos = nil, nil, 0, nil
                                    cpXpBefore = nil
                                    afResetGroundPath()
                                    afDistance = cpProcessed
                                    afRenderTerminal()
                                    return
                                end
                            else
                                -- ждём отъезда: стоим у машины, смотрим на неё, R не спамим
                                afMoveDirection = Vector3.zero
                                pcall(function()
                                    root.CFrame = CFrame.lookAt(root.Position,
                                        Vector3.new(tgtSeat.Position.X, root.Position.Y, tgtSeat.Position.Z))
                                end)
                                afState = "VERIFY CAR " .. math.floor(os.clock() - cpVerifyStart) .. "s (" .. cpProcessed .. ")"
                                afDistance = cpProcessed
                                afRenderTerminal()
                                return
                            end
                        end
                        -- 1) RUSH на точку поста (в обход стен)
                        if ld > approachArrive then
                            afState = "RUSH CAR " .. tgtIdx .. " (" .. math.floor(ld) .. "m)"
                            cpNavigateTo(root, {
                                Position = approachPos,
                                Parent = workspace,
                                Arrive = approachArrive,
                                NoSnap = approachNoSnap,
                                DirectDistance = 45,
                                StateLabel = "RUSH CAR " .. tgtIdx,
                            })
                            afDistance = cpProcessed
                            afRenderTerminal()
                            return
                        end
                        -- 2) HOLD: стоим у машины, Stamp в руках, зажим R.
                        -- подошёл, взял штамп, пропустил. Успех НЕ засчитываем — в VERIFY.
                        afMoveDirection = Vector3.zero
                        if promptAnchor and promptAnchor.prompt and promptAnchor.pos then
                            local promptMax = 10
                            pcall(function() promptMax = promptAnchor.prompt.MaxActivationDistance end)
                            local promptDistance = (promptAnchor.pos - root.Position).Magnitude
                            if promptDistance > math.max(3, promptMax - 0.5) then
                                afState = "CLOSE R PROMPT " .. tgtIdx .. " (" .. math.floor(promptDistance) .. "/" .. math.floor(promptMax) .. "m)"
                                cpNavigateTo(root, {
                                    Position = promptAnchor.pos,
                                    Parent = workspace,
                                    Arrive = math.max(3, math.min(6, promptMax - 2)),
                                    NoSnap = true,
                                    DirectDistance = 35,
                                    StateLabel = "CLOSE R PROMPT " .. tgtIdx,
                                })
                                afDistance = cpProcessed
                                afRenderTerminal()
                                return
                            end
                        end
                        pcall(function()
                            root.CFrame = CFrame.lookAt(root.Position,
                                Vector3.new(approachPos.X, root.Position.Y, approachPos.Z))
                        end)
                        local holdFor = cpPostHoldStart > 0 and (os.clock() - cpPostHoldStart) or 0
                        afState = "HOLD CAR [R] " .. math.floor(holdFor) .. "s (" .. cpProcessed .. ")"
                        if holdFor > 45 then
                            afLog("SKIP", "Нет результата 45с — скип")
                            if occ then cpStampedOccupants[occ] = true end
                            cpHoldTries = 0
                            cpPostTargetIdx = nil
                            cpPostHoldStart = 0
                            cpVerifySeat, cpVerifyOccupant, cpVerifyStart, cpVerifySeatPos = nil, nil, 0, nil
                            cpXpBefore = nil
                            afResetGroundPath()
                            afDistance = cpProcessed
                            afRenderTerminal()
                            return
                        end
                        cpEnsureStamp(char, hum)
                        task.wait(0.35)
                        -- промпт в упор (если есть в радиусе) + ВСЕГДА физический R:
                        cpXpBefore = cpSnapStats()
                        local held = cpTryNearbyClearPrompt(char, hum, root, occ or "CAR", true, holdFor)
                        if held then
                            cpVerifySeat, cpVerifyOccupant, cpVerifyStart, cpVerifySeatPos = tgtSeat, occ, os.clock(), tgtSeat.Position
                            cpHoldTries = cpHoldTries + 1
                            afState = "VERIFY CAR"
                            afRenderTerminal()
                            return
                        end
                        cpXpBefore = nil
                        afDistance = cpProcessed
                        afRenderTerminal()
                        return
                end
                -- никого для обслуживания: падаем ниже на патруль
                -- Совсем пусто: патруль по точкам чтобы не стоять AFK
                -- (Pathfinding в обход стен, ноклип выкл)
                do
                    local patrolPos = cpPatrolRoute[cpPatrolIndex]
                    local patrolDist = (patrolPos - root.Position).Magnitude
                    if patrolDist <= 8 then
                        cpPatrolIndex = cpPatrolIndex + 1
                        if cpPatrolIndex > #cpPatrolRoute then cpPatrolIndex = 1 end
                        afResetGroundPath()
                        afState = "PATROL WAITING (" .. cpProcessed .. ")"
                    else
                        afState = "PATROL " .. cpPatrolIndex .. "/" .. #cpPatrolRoute .. " (" .. math.floor(patrolDist) .. "m)"
                        cpNavigateTo(root, { Position = patrolPos, Parent = workspace })
                    end
                end
                afDistance = cpProcessed
                afRenderTerminal()
            end)
            if not ok then
                afState = "CHECKPOINT ERROR"
                afLog("ERROR", err)
            end
            task.wait(0.25)
        end
        afState = "OFFLINE"
        afDisableNoclip()
        afStopMovement()
        afRenderTerminal()
    end


