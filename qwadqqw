    -- ========== AIMBOT (порт ядра из mainV1) ==========
    -- mainV1: AimState / ClearAimLockState / GetCrosshairViewportPosition /
    -- TARGET_GROUPS / GetCharacter / InEnemyTeam / Raycast+ObjectOccluded /
    -- GetClosest / AimAt / GetCachedTarget / UpdateFOVCircle / UpdateAim /
    -- ShootBot-loop / RMB-hold + Ctrl+` toggle. Упрощено под WindUI-хаб:
    -- без whitelist/blacklist/priority (только TeamCheck), прямой поиск персонажа.
    -- Состояние лежит в AimSys (см. выше): чанк-лимит 200 регистров.

    function aimClearState(resetMouseMode)
        AimSys.State.LastTarget = nil
        AimSys.State.LastX = nil
        AimSys.State.LastY = nil
        if resetMouseMode then
            AimSys.State.LastMouseMode = nil
        end
    end

    function aimCrosshairPos(mouseBehavior)
        local cam = Camera or workspace.CurrentCamera
        if not cam then return nil, nil, false end
        local vs = cam.ViewportSize
        if AimSys.Cfg.Mobile or mouseBehavior == Enum.MouseBehavior.LockCenter then
            return vs.X * 0.5, vs.Y * 0.5, true
        end
        local ok, loc = pcall(function() return UserInputService:GetMouseLocation() end)
        if not ok or not loc then return nil, nil, false end
        local x, y = loc.X, loc.Y
        if x ~= x or y ~= y then return nil, nil, false end
        if x < 0 or y < 0 or x > vs.X or y > vs.Y then return nil, nil, false end
        return x, y, true
    end

    -- Зоны прицеливания лежат в AimSys.Groups (mainV1: TARGET_GROUPS).

    function aimGetCharacter(player)
        if not player or not player.Parent then return nil, nil end
        local char = player.Character
        if not char or not char.Parent then return nil, nil end
        local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if not root or not root.Parent then return nil, nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then return nil, nil end
        return char, root
    end

    -- Сидит ли персонаж в транспорте (Seat/VehicleSeat). Тогда корпус машины
    -- перекрывает Raycast-луч — такую цель берём без проверки видимости.
    function aimIsSeated(char)
        if not char or not char.Parent then return false end
        local ok, hum = pcall(function() return char:FindFirstChildOfClass("Humanoid") end)
        if not ok or not hum then return false end
        local okSeated, seated = pcall(function() return hum.Seated end)
        if okSeated and seated then return true end
        local okSeat, seat = pcall(function() return hum.SeatPart end)
        if okSeat and seat and (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then return true end
        return false
    end

    -- Кто сидит за рулём/в салоне машины, в которую попал курсор (для ShootBot:
    -- Mouse.Target тогда деталь авто, а не персонажа).
    function aimVehicleOccupant(targetPart)
        local node = targetPart
        for _ = 1, 6 do
            if not node or node == game then return nil end
            if node:IsA("Model") and not Players:GetPlayerFromCharacter(node) then
                local seat = node:FindFirstChildWhichIsA("VehicleSeat", true)
                    or node:FindFirstChildWhichIsA("Seat", true)
                if seat then
                    local ok, occ = pcall(function() return seat.Occupant end)
                    if ok and occ then
                        local occChar = occ.Parent
                        local plr = occChar and Players:GetPlayerFromCharacter(occChar) or nil
                        if plr then return plr end
                    end
                end
            end
            node = node.Parent
        end
        return nil
    end

    function aimInEnemyTeam(player)
        if not AimSys.Cfg.TeamCheck then return true end
        local lpTeam, pTeam = LocalPlayer.Team, player.Team
        if lpTeam and pTeam then
            return lpTeam ~= pTeam
        end
        return true
    end

    -- Raycast-параметры лежат в AimSys.RayParams (инициализация выше, рядом с AimSys).

    function aimOccluded(origin, pos, char)
        if not AimSys.Cfg.VisCheck then return false end
        if typeof(pos) ~= "Vector3" then return false end
        AimSys.RayParams.FilterDescendantsInstances = {LocalPlayer.Character, char}
        local ok, hit = pcall(function()
            return workspace:Raycast(origin, pos - origin, AimSys.RayParams)
        end)
        if ok and hit and hit.Instance and not hit.Instance:IsDescendantOf(char) then
            return true
        end
        return false
    end

    function aimCollectParts(out)
        table.clear(out)
        local anySelected = false
        if AimSys.Cfg.Head then
            anySelected = true
            for _, n in ipairs(AimSys.Groups.Head) do table.insert(out, n) end
        end
        if AimSys.Cfg.Torso then
            anySelected = true
            for _, n in ipairs(AimSys.Groups.Torso) do table.insert(out, n) end
        end
        if AimSys.Cfg.LeftArm then
            anySelected = true
            for _, n in ipairs(AimSys.Groups.LeftArm) do table.insert(out, n) end
        end
        if AimSys.Cfg.RightArm then
            anySelected = true
            for _, n in ipairs(AimSys.Groups.RightArm) do table.insert(out, n) end
        end
        if AimSys.Cfg.LeftLeg then
            anySelected = true
            for _, n in ipairs(AimSys.Groups.LeftLeg) do table.insert(out, n) end
        end
        if AimSys.Cfg.RightLeg then
            anySelected = true
            for _, n in ipairs(AimSys.Groups.RightLeg) do table.insert(out, n) end
        end
        -- mainV1: ничего не выбрано = все части тела
        if not anySelected then
            for _, group in pairs(AimSys.Groups) do
                for _, n in ipairs(group) do table.insert(out, n) end
            end
        end
        return out
    end

    -- Сортировка вставками по экранной близости (mainV1: BoundedInsertionSort).
    function aimSortCands(list, count)
        for i = 2, count do
            local key = list[i]
            local j = i - 1
            while j > 0 and key.mag < list[j].mag do
                list[j + 1] = list[j]
                j = j - 1
            end
            list[j + 1] = key
        end
    end

    function aimSetResult(e)
        AimSys.Result[1], AimSys.Result[2], AimSys.Result[3] = e.ply, e.char, e.part
        AimSys.Result[4], AimSys.Result[5] = e.sx, e.sy
        return AimSys.Result
    end

    -- Буферы лежат в AimSys.CheckParts / AimSys.Result.

    -- GetClosest 1:1 по mainV1: сбор кандидатов в FOV -> сортировка ->
    -- sticky-цель (держим прошлую) -> первый невидимый сквозь стены.
    function aimGetClosest()
        if not AimSys.Cfg.Enabled then return nil end
        local cam = Camera or workspace.CurrentCamera
        if not cam then return nil end
        local camPos = cam.CFrame.Position
        local camLook = cam.CFrame.LookVector
        local crossX, crossY, okCross = aimCrosshairPos(UserInputService.MouseBehavior)
        if not okCross then return nil end
        aimCollectParts(AimSys.CheckParts)
        local myChar0 = LocalPlayer.Character
        local myRoot0 = myChar0 and myChar0:FindFirstChild("HumanoidRootPart")
        local myPos = myRoot0 and myRoot0.Position or nil
        local cands = AimSys.Cands
        local maxC = AimSys.MaxCands * 3
        local n = 0
        local function pushCand(ply, char, part, pos, seated)
            if myPos and (pos - myPos).Magnitude > AimSys.Cfg.MaxDist then return end
            local sp, onScreen = cam:WorldToViewportPoint(pos)
            if not onScreen or sp.Z <= 0 then return end
            local dx, dy = sp.X - crossX, sp.Y - crossY
            local mag = math.sqrt(dx * dx + dy * dy)
            -- телефон: мишень минимум 140px; прилипшую цель держим с запасом x1.6
            local fr = AimSys.Cfg.Radius
            if AimSys.Cfg.Mobile and fr < 140 then fr = 140 end
            local lim = fr
            if ply == AimSys.State.LastTarget then lim = fr * 1.6 end
            if mag >= lim then return end
            if n >= maxC then return end
            n = n + 1
            local e = cands[n]
            if not e then
                e = {}
                cands[n] = e
            end
            e.mag, e.ply, e.char, e.part = mag, ply, char, part
            e.sx, e.sy, e.pos, e.seated = sp.X, sp.Y, pos, seated
        end
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Parent and aimInEnemyTeam(player)
                and aimFactionEnabled[getFaction(player)] then
                local char, root = aimGetCharacter(player)
                if char and root then
                    -- сидящего в машине корпус перекрывает: смотрим и позади камеры тоже
                    local seatedInCar = AimSys.Cfg.VehicleTargets and aimIsSeated(char)
                    if seatedInCar or camLook:Dot(root.Position - camPos) >= 0 then
                        for _, partName in ipairs(AimSys.CheckParts) do
                            local part = char:FindFirstChild(partName)
                            if part then
                                pushCand(player, char, part, part.Position, seatedInCar)
                            end
                        end
                    end
                end
            end
        end
        if n == 0 then return nil end
        if n > 1 then aimSortCands(cands, n) end
        -- sticky из mainV1: прошлая цель в приоритете, если видима
        local sticky = AimSys.State.LastTarget
        if sticky then
            for i = 1, n do
                local e = cands[i]
                if e and e.ply == sticky then
                    if e.seated or not aimOccluded(camPos, e.pos, e.char) then
                        return aimSetResult(e)
                    end
                    break
                end
            end
        end
        local limit = math.min(n, AimSys.MaxCands)
        for i = 1, limit do
            local e = cands[i]
            if e and (e.seated or not aimOccluded(camPos, e.pos, e.char)) then
                return aimSetResult(e)
            end
        end
        return nil
    end

    function aimAt(hit)
        if not hit then aimClearState(false) return end
        local part = hit[3]
        if not part or not part.Parent then aimClearState(false) return end
        local mode = UserInputService.MouseBehavior
        if mode ~= AimSys.State.LastMouseMode then
            AimSys.State.LastMouseMode = mode
            AimSys.State.LastX, AimSys.State.LastY = nil, nil
        end
        if hit[1] ~= AimSys.State.LastTarget then
            AimSys.State.LastTarget = hit[1]
            AimSys.State.LastX, AimSys.State.LastY = nil, nil
        end
        local cam = Camera or workspace.CurrentCamera
        if not cam then return end
        local targetPos = part.Position
        if (targetPos - cam.CFrame.Position).Magnitude < 1 then return end
        local sp, onScreen = cam:WorldToViewportPoint(targetPos)
        if not onScreen or sp.Z <= 0 then return end
        local ox, oy, okOrigin = aimCrosshairPos(mode)
        if not okOrigin then return end
        AimSys.State.LastX, AimSys.State.LastY = ox, oy
        local dx, dy = sp.X - ox, sp.Y - oy
        local mag = math.sqrt(dx * dx + dy * dy)
        if mag > AimSys.Cfg.Radius then return end
        local mult = AimSys.Cfg.Attraction / 100
        if AimSys.Cfg.Damp and mag < AimSys.Cfg.DampThreshold then
            local damp = math.max(AimSys.Cfg.DampStrength / 100, mag / math.max(AimSys.Cfg.DampThreshold, 0.001))
            mult = mult * damp
        end
        local deltaX = dx * 0.2 * mult
        local deltaY = dy * 0.2 * mult
        if deltaX ~= deltaX or deltaY ~= deltaY then return end
        if AimSys.Cfg.Mobile or typeof(mousemoverel) ~= "function" then
            -- плавная доводка камерой (телефон / нет mousemoverel): жёстко держит цель
            local k = math.clamp(mult * 0.4, 0.15, 0.8)
            pcall(function()
                local cc = Camera or workspace.CurrentCamera
                if cc then
                    cc.CFrame = cc.CFrame:Lerp(CFrame.lookAt(cc.CFrame.Position, targetPos), k)
                end
            end)
            return
        end
        local vs = cam.ViewportSize
        deltaX = math.clamp(deltaX, -vs.X * 0.5, vs.X * 0.5)
        deltaY = math.clamp(deltaY, -vs.Y * 0.5, vs.Y * 0.5)
        pcall(mousemoverel, math.floor(deltaX + 0.5), math.floor(deltaY + 0.5))
    end

    -- FOV/кэш лежат в AimSys.FovGui/FovFrame/Cached/CachedTime.

    function aimGetCached()
        local now = os.clock()
        if AimSys.Cached and (now - AimSys.CachedTime) < 0.016 then return AimSys.Cached end
        AimSys.Cached = aimGetClosest()
        AimSys.CachedTime = now
        return AimSys.Cached
    end

    function aimUpdateFov()
        if hubDestroyed then return end
        local show = AimSys.Cfg.Enabled and AimSys.Cfg.ShowCircle
        if not show then
            if AimSys.FovFrame then pcall(function() AimSys.FovFrame.Visible = false end) end
            return
        end
        local parent = getGuiParent()
        if not parent then return end
        if not AimSys.FovFrame or not AimSys.FovFrame.Parent then
            pcall(function() if AimSys.FovFrame then AimSys.FovFrame:Destroy() end end)
            if not AimSys.FovGui or not AimSys.FovGui.Parent then
                AimSys.FovGui = Instance.new("ScreenGui")
                AimSys.FovGui.Name = "LuaHubAimFOV"
                AimSys.FovGui.ResetOnSpawn = false
                AimSys.FovGui.IgnoreGuiInset = true
                AimSys.FovGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
                pcall(function() AimSys.FovGui.Parent = parent end)
            end
            AimSys.FovFrame = Instance.new("Frame")
            AimSys.FovFrame.Name = "FOVCircle"
            AimSys.FovFrame.BackgroundTransparency = 1
            AimSys.FovFrame.BorderSizePixel = 0
            AimSys.FovFrame.AnchorPoint = Vector2.new(0.5, 0.5)
            AimSys.FovFrame.ZIndex = 10
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(1, 0)
            corner.Parent = AimSys.FovFrame
            local stroke = Instance.new("UIStroke")
            stroke.Thickness = 1
            stroke.Color = Color3.fromRGB(0, 220, 110)
            stroke.Transparency = 0.3
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Parent = AimSys.FovFrame
            AimSys.FovFrame.Parent = AimSys.FovGui
        end
        local cx, cy, okCross = aimCrosshairPos(UserInputService.MouseBehavior)
        if okCross then
            local d = math.max(AimSys.Cfg.Radius * 2, 2)
            AimSys.FovFrame.Size = UDim2.fromOffset(d, d)
            AimSys.FovFrame.Position = UDim2.fromOffset(cx, cy)
            AimSys.FovFrame.Visible = true
        else
            AimSys.FovFrame.Visible = false
        end
    end

    function aimUpdate()
        pcall(aimUpdateFov)
        if hubDestroyed then return end
        Camera = workspace.CurrentCamera
        if not AimSys.Cfg.Enabled then aimClearState(false) return end
        local active = AimSys.Cfg.Always or AimSys.State.Aim
        if not active then aimClearState(false) return end
        local target = aimGetCached()
        if target then
            aimAt(target)
        else
            aimClearState(false)
        end
    end

    function aimPartInShootGroup(name)
        if AimSys.Shoot.Head and name == "Head" then return true end
        if AimSys.Shoot.Torso and (name == "Torso" or name == "UpperTorso" or name == "LowerTorso" or name == "HumanoidRootPart") then return true end
        if AimSys.Shoot.LeftArm and (name == "Left Arm" or name == "LeftUpperArm" or name == "LeftLowerArm" or name == "LeftHand") then return true end
        if AimSys.Shoot.RightArm and (name == "Right Arm" or name == "RightUpperArm" or name == "RightLowerArm" or name == "RightHand") then return true end
        if AimSys.Shoot.LeftLeg and (name == "Left Leg" or name == "LeftUpperLeg" or name == "LeftLowerLeg" or name == "LeftFoot") then return true end
        if AimSys.Shoot.RightLeg and (name == "Right Leg" or name == "RightUpperLeg" or name == "RightLowerLeg" or name == "RightFoot") then return true end
        return false
    end

    function aimShootGroupAnySelected()
        return AimSys.Shoot.Head or AimSys.Shoot.Torso or AimSys.Shoot.LeftArm or AimSys.Shoot.RightArm or AimSys.Shoot.LeftLeg or AimSys.Shoot.RightLeg
    end

    -- Коннекты лежат в AimSys.Conn/BeganConn/EndedConn.

    function aimStart()
        if AimSys.Conn then return end
        -- Приоритет ПОСЛЕ камеры игры: наш CFrame финальный каждый кадр,
        -- тач/скрипты игры уже не откидывают прицел (критично на телефоне).
        pcall(function() RunService:UnbindFromRenderStep("LuaHubAim") end)
        local ok = pcall(function()
            RunService:BindToRenderStep("LuaHubAim", Enum.RenderPriority.Camera.Value + 1, aimUpdate)
        end)
        if ok then
            AimSys.Conn = true
        else
            AimSys.Conn = RunService.RenderStepped:Connect(aimUpdate)
        end
        AimSys.BeganConn = UserInputService.InputBegan:Connect(function(input, gpe)
            if input.UserInputType == Enum.UserInputType.MouseButton2 and not gpe then
                if AimSys.Cfg.Enabled then AimSys.State.Aim = true end
            end
            if not gpe and input.KeyCode == Enum.KeyCode.Backquote then
                local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
                    or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
                if ctrl then
                    AimSys.Cfg.Enabled = not AimSys.Cfg.Enabled
                    if AimSys.ToggleRef then pcall(function() AimSys.ToggleRef:SetValue(AimSys.Cfg.Enabled) end) end
                    Notify("Aimbot", AimSys.Cfg.Enabled and "Camera Tracking ON (Ctrl+`)" or "Camera Tracking OFF (Ctrl+`)", 2)
                end
            end
        end)
        AimSys.EndedConn = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton2 then
                AimSys.State.Aim = false
            end
        end)
        -- ShootBot из mainV1: авто-клик по врагу под курсором с CPS
        task.spawn(function()
            while not hubDestroyed do
                local fire = AimSys.Shoot.Enabled and AimSys.Cfg.Enabled
                if fire and typeof(isrbxactive) == "function" and typeof(mouse1press) == "function" and typeof(mouse1release) == "function" then
                    local active = isrbxactive()
                    if active then
                        local okMouse, mouse = pcall(function() return LocalPlayer:GetMouse() end)
                        local targetPart = okMouse and mouse and mouse.Target or nil
                        if targetPart then
                            local char = targetPart.Parent
                            while char and char ~= game and not Players:GetPlayerFromCharacter(char) do
                                char = char.Parent
                            end
                            local plr = char and char ~= game and Players:GetPlayerFromCharacter(char) or nil
                            -- Курсор на детали авто: ищем кто сидит внутри (водитель/пассажир).
                            local viaVehicle = false
                            if (not plr) and AimSys.Cfg.VehicleTargets and targetPart then
                                plr = aimVehicleOccupant(targetPart)
                                viaVehicle = (plr ~= nil)
                            end
                            if plr and plr ~= LocalPlayer then
                                local enemy = true
                                if AimSys.Shoot.TeamCheck then
                                    local lt, pt = LocalPlayer.Team, plr.Team
                                    enemy = not (lt and pt and lt == pt)
                                end
                                local c2, _r2 = aimGetCharacter(plr)
                                if enemy and c2 then
                                    -- В машине: деталь под курсором — корпус авто, а не часть тела, проверку зоны пропускаем.
                                    local shouldFire = viaVehicle or not aimShootGroupAnySelected() or aimPartInShootGroup(targetPart.Name)
                                    if shouldFire then
                                        local cps = math.clamp(AimSys.Shoot.CPS, 1, 100)
                                        pcall(mouse1press)
                                        task.wait(1 / cps / 2)
                                        pcall(mouse1release)
                                        task.wait(1 / cps / 2)
                                    else
                                        task.wait()
                                    end
                                else
                                    task.wait()
                                end
                            else
                                task.wait()
                            end
                        else
                            task.wait()
                        end
                    else
