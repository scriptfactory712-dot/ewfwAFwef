    local scanRunning = false
    local rescanNeeded = false
    local hubDestroyed = false
    -- FIX 4: loop instead of recursion (no stack buildup on rapid re-scans)
    function fullScanAsync()
        if scanRunning then rescanNeeded = true return end
        scanRunning = true
        task.spawn(function()
            while not hubDestroyed do
                local ok, descendants = pcall(function() return workspace:GetDescendants() end)
                if not ok or not descendants then scanRunning = false return end
                local n = #descendants
                local i = 1
                while i <= n do
                    local t0 = os.clock()
                    while i <= n and not hubDestroyed do
                        local v = descendants[i]
                        i = i + 1
                        if not hubDestroyed and v:IsA("Model") and vehEnabled then
                            if isVehicle(v) then addVehicle(v) end
                        end
                        if os.clock() - t0 >= 0.003 then break end
                    end
                    task.wait()
                end
                if hubDestroyed then
                    scanRunning = false
                    return
                end
                local vCount = 0
                for _ in pairs(vehCache) do vCount = vCount + 1 end
                nextAutoRefresh = os.clock() + 10
                if vCount ~= lastVehCount then
                    lastVehCount = vCount
                    Notify("Auto-Refresh", "транспорт: " .. vCount, 2)
                end
                if rescanNeeded then
                    rescanNeeded = false
                    -- loop again instead of recursing
                else
                    scanRunning = false
                    break
                end
            end
            scanRunning = false
        end)
    end

    function doAutoRefresh()
        for model in pairs(vehCache) do
            if not model.Parent then removeVehicle(model) end
        end
        if vehEnabled then
            fullScanAsync()
        else
            nextAutoRefresh = os.clock() + 10
        end
    end

    -- ========== КОРАБЛЬ + КОНТЕЙНЕРЫ ==========
    local SHIP_COLOR = Color3.fromRGB(255, 60, 60)
    local CONTAINER_COLOR = Color3.fromRGB(0, 255, 255)
    local SHIP_ROOT_KEYWORDS = {"cargo ship","cargo liner","container ship","ship","vessel","mv ocean crest","ocean crest"}
    local SHIP_BLACKLIST = {"container","crate","box","crane","pallet","barrel"}
    local CONTAINER_KEYWORDS = {"container","cargo container","crate","shipping container","shippingcontainer","cargo box","cargobox","storage","ящик","контейнер"}

    local shipHighlight = nil
    local shipModel = nil
    local nextShipScan = 0
    local SHIP_SCAN_INTERVAL = 5
    local containerCache = {}
    local containerCount = 0
    local MAX_CONTAINERS = 400

    function isShipRootModel(model)
        if typeof(model) ~= "Instance" or not model:IsA("Model") then return false end
        if Players:GetPlayerFromCharacter(model) then return false end
        -- Точное имя из игры (F9-дамп): Workspace.CargoShips.CargoShip
        if model.Name == "CargoShip" then
            local par = model.Parent
            if par and par.Name == "CargoShips" then return true end
        end
        local name = string.lower(model.Name)
        for _, badWord in ipairs(SHIP_BLACKLIST) do
            if string.find(name, badWord, 1, true) then return false end
        end
        for _, goodWord in ipairs(SHIP_ROOT_KEYWORDS) do
            if string.find(name, goodWord, 1, true) then
                local primary = model.PrimaryPart
                if primary then
                    local size = primary.Size
                    if size.X > 30 or size.Y > 15 or size.Z > 30 then return true end
                else
                    local ok, _, boundingSize = pcall(function() return model:GetBoundingBox() end)
                    if ok and boundingSize and boundingSize.Magnitude > 50 then return true end
                end
            end
        end
        return false
    end

    function isContainerPart(inst)
        if typeof(inst) ~= "Instance" then return false end
        if not (inst:IsA("BasePart") or inst:IsA("Model")) then return false end
        if inst:IsA("Model") and not inst:FindFirstChildWhichIsA("BasePart", true) then return false end
        local n = string.lower(inst.Name)
        for _, kw in ipairs(CONTAINER_KEYWORDS) do
            if string.find(n, kw, 1, true) then return true end
        end
        return false
    end

    function hasContainerAncestor(inst)
        local p = inst.Parent
        while p and p ~= workspace and p ~= shipModel do
            if isContainerPart(p) then return true end
            p = p.Parent
        end
        return false
    end

    function addContainer(inst)
        if containerCache[inst] then return end
        if containerCount >= MAX_CONTAINERS then return end
        local hl = createHighlight(inst, CONTAINER_COLOR, 0.15, 0)
        if hl then
            if containerEnabled then pcall(hlEnable, hl) end
            containerCache[inst] = hl
            containerCount = containerCount + 1
        end
    end

    function removeContainer(inst)
        local hl = containerCache[inst]
        if hl then
            pcall(instDestroy, hl)
            containerCache[inst] = nil
            containerCount = containerCount - 1
            if containerCount < 0 then containerCount = 0 end
        end
    end

    function clearContainers()
        for inst in pairs(containerCache) do removeContainer(inst) end
        containerCache = {}
        containerCount = 0
    end

    function collectContainersOnShip()
        if not shipModel or not shipModel.Parent then return end
        local added = 0
        local ok, descendants = pcall(function() return shipModel:GetDescendants() end)
        if not ok or not descendants then return end
        for _, d in ipairs(descendants) do
            if containerCount >= MAX_CONTAINERS then break end
            if isContainerPart(d) and not hasContainerAncestor(d) then
                addContainer(d)
                added = added + 1
            end
        end
        if added > 0 then
            Notify("Container ESP", "Найдено контейнеров: " .. added, 3)
        end
    end

    local shipScanRunning = false
    -- Узнать ТОЧНОЕ имя судна в игре: берём самую большую модель с морским
    -- именем и копируем полный путь в буфер. Важно: подплыть ближе (стриминг!).
    function linerCopyShipName()
        local best, bestScore = nil, 0
        local ok, all = pcall(function() return workspace:GetDescendants() end)
        if ok and all then
            for _, v in ipairs(all) do
                if (v:IsA("Model") or v:IsA("Folder")) and not Players:GetPlayerFromCharacter(v) then
                    local n = string.lower(v.Name)
                    local score = 0
                    for _, kw in ipairs({"ocean crest", "cargo liner", "container ship", "cargo ship", "liner", "crest", "freighter", "ship", "vessel", "boat"}) do
                        if n:find(kw, 1, true) then score = score + 10 end
                    end
                    if score > 0 then
                        local mag = 0
                        if v:IsA("Model") then
                            local okB, _, sizeB = pcall(function() return v:GetBoundingBox() end)
                            if okB and sizeB then mag = sizeB.Magnitude end
                        end
                        score = score + math.min(mag, 500)
                        if score > bestScore then bestScore, best = score, v end
                    end
                end
            end
        end
        if best then
            pcall(function() setclipboard(best:GetFullName()) end)
            Notify("Liner", "Судно: " .. best.Name .. " (скопировано)", 5)
            print("[Liner] EXACT SHIP NAME: " .. best:GetFullName())
        else
            Notify("Liner", "Морских моделей рядом нет. Подплыви ближе.", 4)
        end
    end

    function scanForShipAsync()
        if shipScanRunning then return end
        shipScanRunning = true
        task.spawn(function()
            local ok, descendants = pcall(function() return workspace:GetDescendants() end)
            if ok and descendants then
                local best, bestScore = nil, 0
                local n = #descendants
                local i = 1
                while i <= n and not hubDestroyed do
                    local t0 = os.clock()
                    while i <= n do
                        local v = descendants[i]
                        i = i + 1
                        if isShipRootModel(v) then
                            local ln = string.lower(v.Name)
                            local score = 0
                            if string.find(ln, "cargo ship", 1, true) then score = 100
                            elseif string.find(ln, "cargo liner", 1, true) then score = 95
                            elseif string.find(ln, "container ship", 1, true) then score = 90
                            elseif string.find(ln, "ship", 1, true) then score = 50
                            elseif string.find(ln, "vessel", 1, true) then score = 40
                            else score = 10 end
                            local primary = nil
                            pcall(function() primary = v.PrimaryPart end)
                            if primary and primary.Size.Magnitude > 100 then score = score + 20 end
                            if score > bestScore then bestScore = score; best = v end
                        end
                        if os.clock() - t0 >= 0.003 then break end
                    end
                    task.wait()
                end
                if not hubDestroyed and best and (not shipModel or not shipModel.Parent) then
                    shipModel = best
                    shipHighlight = createHighlight(best, SHIP_COLOR, 0.75, 0.2)
                    Notify("Ship ESP", "Корабль найден: " .. best.Name, 3)
                    if containerEnabled then collectContainersOnShip() end
                end
            end
            shipScanRunning = false
        end)
    end

    function updateShipESP()
        if not shipEnabled then return end
        local shipAlive = shipModel and shipModel.Parent and isShipRootModel(shipModel)
        if not shipAlive then
            if shipHighlight then pcall(instDestroy, shipHighlight); shipHighlight = nil end
            shipModel = nil
            clearContainers()
            if os.clock() >= nextShipScan then
                nextShipScan = os.clock() + SHIP_SCAN_INTERVAL
                scanForShipAsync()
            end
        end
        if shipHighlight and shipHighlight.Parent then
            local color = shipRainbow and rainbowColor or SHIP_COLOR
            pcall(setShipHl, shipHighlight, color)
        end
        if containerEnabled and containerCount > 0 then
            local color = shipRainbow and rainbowColor or CONTAINER_COLOR
            for inst, hl in pairs(containerCache) do
                if not inst.Parent then removeContainer(inst)
                else pcall(setContainerHl, hl, color) end
            end
        end
    end

