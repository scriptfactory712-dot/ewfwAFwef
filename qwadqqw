            c.tr1.From, c.tr1.To, c.tr1.Color, c.tr1.Thickness, c.tr1.Visible = Vector2.new(topX + width, topY), Vector2.new(topX + width - lenX, topY), color, 1.5, true
            c.tr2.From, c.tr2.To, c.tr2.Color, c.tr2.Thickness, c.tr2.Visible = Vector2.new(topX + width, topY), Vector2.new(topX + width, topY + lenY), color, 1.5, true
