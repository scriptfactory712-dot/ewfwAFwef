    -- Диагностика будки: что РЕАЛЬНО вокруг (промпты/сиденья/GUI/тулы).
    -- Встань у будки рядом с машиной и жми кнопку SCAN → смотри F9.
    -- По выводу будет видно, почему R не жмётся (нет промптов / не тот класс / далеко).
    function cpScanBooth()
        local root = getRootPart()
        if not root then print("[SCAN] нет персонажа"); return end
        local rp = root.Position
        print("========== BOOTH SCAN ==========")
        local np, ns = 0, 0
        local okD, desc = pcall(function() return workspace:GetDescendants() end)
        if okD and desc then
            for _, obj in ipairs(desc) do
                if obj:IsA("ProximityPrompt") then
                    local part = obj.Parent
                    while part and part ~= workspace and not part:IsA("BasePart") do part = part.Parent end
                    local d = part and (part.Position - rp).Magnitude or 99999
                    if d <= 80 then
                        np = np + 1
                        print(string.format("[PROMPT %d] name=%s action=%s object=%s key=%s enabled=%s hold=%s maxdist=%s los=%s dist=%.1fm parent=%s",
                            np, tostring(obj.Name), tostring(obj.ActionText), tostring(obj.ObjectText),
                            tostring(obj.KeyboardKeyCode), tostring(obj.Enabled),
                            tostring(obj.HoldDuration), tostring(obj.MaxActivationDistance),
                            tostring(obj.RequiresLineOfSight), d,
                            part and part:GetFullName() or "?"))
                    end
                elseif obj:IsA("VehicleSeat") or obj:IsA("Seat") then
                    if obj.Occupant then
                        local d = (obj.Position - rp).Magnitude
                        if d <= 120 then
                            ns = ns + 1
                            local sp = 0
                            pcall(function() sp = obj.AssemblyLinearVelocity.Magnitude end)
                            print(string.format("[SEAT %d] class=%s dist=%.1fm speed=%.1f occupant=%s model=%s",
                                ns, obj.ClassName, d, sp,
                                (obj.Occupant.Parent and obj.Occupant.Parent.Name) or "?",
                                (obj.Parent and obj.Parent:GetFullName()) or "?"))
                        end
                    end
                end
            end
        end
        print("PROMPTS: " .. np .. "  SEATS: " .. ns)
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pg then
            local okG, gdesc = pcall(function() return pg:GetDescendants() end)
            if okG and gdesc then
                for _, obj in ipairs(gdesc) do
                    if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Visible then
                        local t = tostring(obj.Text)
                        local tl = t:lower()
                        if tl:find("clear to pass", 1, true) or tl:find("grant entry", 1, true)
                            or tl:find("approve", 1, true) or tl:find("stamp", 1, true) then
                            print("[GUI] " .. obj:GetFullName() .. " = " .. t)
                        end
                    end
                end
            end
        end
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        for _, c in ipairs({ LocalPlayer.Character, bp }) do
            if c then
                for _, it in ipairs(c:GetChildren()) do
                    if it:IsA("Tool") then print("[TOOL] " .. it.Name .. " in " .. c.Name) end
                end
            end
        end
        print("========== END SCAN ==========")
        Notify("Scan", "Промптов: " .. np .. ", сидений: " .. ns .. " (смотри F9)", 5)
    end


