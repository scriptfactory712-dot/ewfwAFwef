-- WindUI load: 3 ретрая primary + fallback через request-библиотеку
-- (у некоторых экзекуторов game:HttpGet не тянет редиректы GitHub).
local WINDUI_URLS = {
    "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua",
    "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
}
local loadSuccess = false
local loadErr = "unknown"
do
    function tryFetch(url)
        -- 1) штатный HttpGet
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if ok and type(body) == "string" and #body > 1000 then return body end
        -- 2) request-библиотека экзекутора (лучше держит редиректы)
        local req = (request or http_request or (syn and syn.request))
        if req then
            local ok2, res = pcall(function()
                return req({ Url = url, Method = "GET" })
            end)
            if ok2 and res then
                local b = res.Body or res.body
                if type(b) == "string" and #b > 1000 then return b end
            end
        end
        return nil
    end
    for _, url in ipairs(WINDUI_URLS) do
        for attempt = 1, 3 do
            pushLog("fetch WindUI try " .. attempt .. " (" .. url:sub(9, 28) .. ")", "..")
            local body = tryFetch(url)
            if body then
                local ok, result = pcall(function() return loadstring(body)() end)
                if ok and type(result) == "table" then
                    WindUI, loadSuccess = result, true
                    break
                elseif ok and type(result) == "function" then
                    local ok2, result2 = pcall(result)
                    if ok2 and type(result2) == "table" then
                        WindUI, loadSuccess = result2, true
                        break
                    end
                else
                    loadErr = tostring(result):sub(1, 80)
                end
            else
                loadErr = "http fetch failed"
            end
            task.wait(1)
        end
        if loadSuccess then break end
    end
end

if not loadSuccess or not WindUI then
    Update("WindUI load failed: " .. tostring(loadErr):sub(1, 60), 1.0, "FAIL")
    task.wait(0.4)
    pushLog("abort boot sequence", "FAIL")
    pushLog("включи HTTP Requests в экзекуторе / проверь интернет", "FAIL")
    warn("[Lua Hub] WindUI load failed: " .. tostring(loadErr))
    Notify("Error", "WindUI failed: " .. tostring(loadErr):sub(1, 60), 8)
    task.wait(4)
    pcall(function() gui:Destroy() end)
    return
end

