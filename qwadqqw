-- Чистые хелперы, вынесенные из хаб-функции (тот же лимит 200 регистров).
-- Используют только аргументы и чанк-апвелю (LocalPlayer/VirtualInputManager).
local function parseWantedValue(val)
    -- FIX Wanted: BoolValue true/false раньше давал 0 (tonumber(true)=nil)
    if type(val) == "boolean" then return val and 1 or 0 end
    local n = tonumber(val)
    if n then
        if n >= 1 and n <= 5 then return math.floor(n) end
        if n > 5 then return 5 end
        return 0
    end
    local s = tostring(val):lower()
    -- строковые флаги: "true"/"wanted"/"criminal" = 1 звезда, "false"/"none"/"clean" = 0
    if s == "true" or s == "wanted" or s == "criminal" or s == "outlaw"
        or s == "fugitive" or s == "suspect" then
        return 1
    end
    if s == "false" or s == "none" or s == "clean" or s == "clear"
        or s == "innocent" or s == "nil" then
        return 0
    end
    local num = tonumber(s:match("%d+"))
    if num then
        if num >= 1 and num <= 5 then return math.floor(num) end
        if num > 5 then return 5 end
    end
    local starCount = 0
    for _ in s:gmatch("[*★✦✧]") do starCount = starCount + 1 end
    if starCount > 0 then return math.min(starCount, 5) end
    return 0
end
